DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tuti"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Where the app (marketing, team sign-in, /app) lives
APP_URL="http://localhost:3100"
# Where each project's public portal lives. {project} is replaced by the slug,
# e.g. "https://{project}.tuti.so". Needs a wildcard DNS record.
# Locally, http://<project>.localhost:3100 always works too.
PORTAL_URL_TEMPLATE="http://{project}.localhost:3100"

# Development only: the hosts you open the dev server from, when they aren't localhost, comma-separated
# (e.g. "devbox.example.com,*.devbox.example.com"). Next.js blocks its dev resources on other hosts, so
# client code wouldn't run.
# ALLOWED_DEV_ORIGINS=""

# Optional: portals on their own domains (help.acme.com). Set the hostname customers point
# their domain at with a CNAME, e.g. "customers.example.com"; your proxy must send any host
# there to this app and get it a TLS certificate (e.g. Caddy's on-demand TLS). A TXT record
# proves each domain is the team's; Tuti looks it up over DNS-over-HTTPS (Cloudflare's, unless
# DNS_LOOKUP_URL names another resolver's JSON API). Without it, custom domains are off.
# CUSTOM_DOMAIN_TARGET=""
# DNS_LOOKUP_URL="https://cloudflare-dns.com/dns-query"
# Or Cloudflare for SaaS gets their certificates: a zone with Custom Hostnames on and its fallback
# origin set to CUSTOM_DOMAIN_TARGET (a proxied record to this server), and a token for it with
# SSL and Certificates: Edit. Each domain gets a custom hostname there once it's verified.
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ZONE_ID=""

# Optional: one project's portal under a path of the app's own domain, the path being its slug
# (e.g. "help": APP_URL/help/docs, /help/feedback/…), such as the portal for this Tuti itself. Sign-in
# there is the app's. Its slug may be a reserved one, like help (not one of the app's own paths,
# like docs or api); only APP_PORTAL_OWNER (that address, verified) can create that project.
# APP_PORTAL_PROJECT=""
# APP_PORTAL_OWNER=""

# Optional: a project whose widget shows in the team app (never on portals), such as the help project
# of this Tuti itself. With SSO on in that project, the widget signs people in with their account.
# APP_WIDGET_PROJECT=""

# Tuti's own server (tuti.so) only, as the licence server: Tuti's private key for licence keys.
# Leave it unset: your installation gets its keys from tuti.so.
# LICENSE_PRIVATE_KEY=""

# Hatchet (Hatchet Cloud or self-hosted): an API token from your Hatchet
# dashboard (Settings → API Tokens). The token carries the server address.
HATCHET_CLIENT_TOKEN=""
# Self-hosted only, if needed: other HATCHET_CLIENT_* settings, e.g.
# HATCHET_CLIENT_TLS_STRATEGY="none" for a server without TLS, or
# HATCHET_CLIENT_HOST_PORT="hatchet.example.com:443" to override the address.
# Or run background jobs inside the web app instead (no Hatchet, no worker,
# no retries); fine for small installs:
# JOBS_DRIVER="inline"

# Optional: duplicate detection with OpenAI text-embedding-3-small.
# Without it, posting works and duplicate detection is skipped.
OPENAI_API_KEY=""
# Optional: an OpenAI-compatible endpoint instead of https://api.openai.com/v1
# OPENAI_BASE_URL=""

# Optional: AI drafting (changelog entries from merged pull requests) and AI answers on the
# docs (these also need OPENAI_API_KEY, to find the articles to answer from) through
# OpenRouter, or any OpenAI-compatible chat completions API. Without a key, AI features are off.
# OPENROUTER_API_KEY=""
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL="anthropic/claude-haiku-5.5"   # any model the endpoint offers
# Each feature's model for every project, instead of AI_MODEL (a project's owners and admins can
# pick another in Settings → AI models):
# AI_MODEL_ANSWERS=""
# AI_MODEL_ESCALATIONS=""
# AI_MODEL_SUPPORT=""
# AI_MODEL_CHANGELOG=""
# AI_MODEL_CODE_CHANGES=""
# The most a model projects pick may cost, in dollars per million output tokens (unset: no cap;
# a model without a price can't be picked under a cap). The defaults above aren't checked.
# AI_MODEL_MAX_PRICE="15"
# Code changes (every merged pull request analysed into the posts it resolves and the docs it
# changes, for the team to apply) also need OPENAI_API_KEY; without it, merged pull requests only feed
# the changelog's running draft. Their decisions use a decision model on the same endpoint (one that
# answers with probabilities, through OpenRouter's Decisions API); the default did best on Tuti's
# evaluation set, and `pnpm test:live` measures another. Set these on the worker too.
# DECISION_MODEL="nace-ai/drex-max"

# AI credits (Tuti's cloud; off by default, so a self-hosted server's AI is as unlimited as its keys):
# projects pay for AI with prepaid credits, and each feature pauses without them. Rates are read when
# credits are bought or spent; the defaults leave no margin. Set AI_CREDITS on the worker too.
# AI_CREDITS="on"
# AI_CREDITS_PER_TOPUP_DOLLAR="100"   # credits a dollar paid buys
# AI_CREDITS_PER_USAGE_DOLLAR="100"   # credits a dollar of model cost spends
# AI_CREDITS_TOPUP_EXPIRY_DAYS="365"  # whole days; 0: for good
# AI_CREDITS_FREE="0"                 # given to every project once
# AI_CREDITS_LOW="100"                # under it, owners and admins are emailed (and once out); 0: only once out
# Buying credits on Stripe Checkout; the webhook (https://<APP_URL>/api/stripe/webhook) listens for
# checkout.session.completed and checkout.session.async_payment_succeeded (and, with plans, the events below).
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# Plans (Tuti's cloud; off by default, so a self-hosted server sells nothing): Pro and Business per
# project, through Stripe subscriptions, at the prices below (ids of recurring prices in your Stripe
# account; a plan without one isn't sold; to replace a price, list the new one first, then the old ones,
# comma-separated, so those who subscribed at them keep their plan). The webhook also listens for customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted and invoice.paid (and, so refunds and
# disputes take back what was paid for, charge.refunded and charge.dispute.created). Each paid month gives the
# plan's AI credits, lasting until the month ends (a year: twelve months' worth, for the year).
# PLANS="on"
# STRIPE_PRICE_PRO_MONTHLY=""
# STRIPE_PRICE_PRO_YEARLY=""
# STRIPE_PRICE_BUSINESS_MONTHLY=""
# STRIPE_PRICE_BUSINESS_YEARLY=""
# The "Powered by tuti" add-on ($49 a month) on a paid plan, one price per billing interval (a
# subscription's prices bill alike); without one it isn't sold on plans billed that way. On the licence
# server (LICENSE_PRIVATE_KEY), the monthly one also sells self-hosted licences on /license (without it,
# that page says to email). STRIPE_PORTAL_LOGIN_URL is Stripe's customer portal login link, where their
# buyers cancel them (without it, the page says to email).
# STRIPE_PRICE_BADGE_MONTHLY=""
# STRIPE_PRICE_BADGE_YEARLY=""
# STRIPE_PORTAL_LOGIN_URL=""
# AI_CREDITS_PRO="1000"               # AI credits a month on Pro
# AI_CREDITS_BUSINESS="5000"          # and on Business

# Email (verification, invites and "it shipped" emails) over SMTP, any provider. Without SMTP_HOST,
# emails are written to the server log instead of being sent.
# SMTP_HOST=""           # e.g. smtp.resend.com, email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT="587"        # 587 upgrades to TLS (STARTTLS); 465 is TLS from the start, but some hosts block it
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# EMAIL_FROM="Acme Feedback <feedback@example.com>"  # required with SMTP_HOST: an address your provider lets you send from

# Optional: email for the support inbox (docs/support-email.md). Each project gets support@<subdomain>.<domain>,
# its team forwards its own support address there, and whatever receives mail for the domain posts each message
# to /api/inbound/email, signed with INBOUND_SECRET. Both, or neither.
# SUPPORT_EMAIL_DOMAIN=""   # e.g. support.example.com: its subdomains' MX points at your receiver
# INBOUND_SECRET=""         # e.g. `openssl rand -hex 32`; the receiver signs with it too

# Optional, with the support inbox's email: Amazon SES's API (docs/support-email.md, "Amazon SES"). Each
# project's email goes out under an SES tenant of its own, so SES pauses only a project whose mail draws
# bounces or complaints. Sending still goes over SMTP_*, which must be SES's. The key only manages
# tenants, identities and configuration sets. All five, or none (the app won't start with some).
# SES_REGION=""             # e.g. us-east-1
# SES_ACCESS_KEY_ID=""
# SES_SECRET_ACCESS_KEY=""
# SES_CONFIGURATION_SET=""  # the one support email names; its events go to the topic below
# SES_EVENTS_TOPIC_ARN=""   # the SNS topic SES sends the configuration set's events to

# Optional: the request header your proxy sets to the visitor's IP address, e.g. "cf-connecting-ip"
# behind Cloudflare. Emailed sign-in and password reset links use it for a per-visitor hourly limit (only a keyed hash of
# the address is stored, for an hour). Only set it if your proxy always overwrites the header: without
# it there's no per-visitor limit (the per-address and per-portal limits still apply).
# TRUSTED_IP_HEADER=""

# Image uploads, to any S3-compatible storage (Cloudflare R2, AWS S3, MinIO, …).
# Without these, uploads are off. Keep the bucket private (no public access, no
# public or custom domain): browsers upload to it and load images from it with
# signed URLs, on MEDIA_S3_ENDPOINT. Its CORS rules must allow PUT from the app
# and portal origins. The keys need read and write access to this bucket only.
# MEDIA_S3_ENDPOINT=""          # e.g. https://<account>.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=""
# MEDIA_S3_ACCESS_KEY_ID=""
# MEDIA_S3_SECRET_ACCESS_KEY=""
# MEDIA_S3_REGION="auto"        # "auto" for R2; your bucket's region on S3
# Optional: signs the lasting image links in emails, link cards and exports
# (openssl rand -base64 32). Set it once and keep it: changing it, or setting it
# later, breaks those links in emails already sent. Unset, BETTER_AUTH_SECRET
# signs them, and rotating that breaks them instead.
# MEDIA_LINK_SECRET=""
# Limits (defaults shown): per image for the team and for portal users, per project.
# MEDIA_MAX_IMAGE_MB_TEAM="10"
# MEDIA_MAX_IMAGE_MB_USER="5"
# MEDIA_PROJECT_QUOTA_MB="1024"

# GitHub (optional): a GitHub App feeds merged pull requests to the changelog's running draft
# (releases close it) and, with AI set up, to code changes. All six GITHUB_APP_* / GITHUB_WEBHOOK_SECRET values are
# needed together (GitHub stays off until they're all set). Register one (Settings → Developer settings → GitHub Apps) with:
#   Setup URL: <APP_URL>/api/github/setup (leave "Request user authorization during installation" off;
#     tick "Redirect on update", so changing its repositories on GitHub comes back to Tuti)
#   Callback URL: <APP_URL>/api/github/callback (Tuti asks who installed, to check they can see the installation)
#   Webhook URL: <APP_URL>/api/github/webhook, with a webhook secret
#   Permissions: Pull requests (read), Contents (read); events: Pull request, Release
# GITHUB_APP_SLUG=""            # from the App's public URL: github.com/apps/<slug>
# GITHUB_APP_CLIENT_ID=""
# GITHUB_APP_CLIENT_SECRET=""
# GITHUB_WEBHOOK_SECRET=""
# GITHUB_APP_ID=""               # the App's ID; with its private key, Tuti lists the repositories it can see
# GITHUB_APP_PRIVATE_KEY=""      # PEM; newlines may be written as \n
# GITHUB_URL="https://github.com"          # GitHub Enterprise: your server
# GITHUB_API_URL="https://api.github.com"
