DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tuti"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Where the app (marketing, team sign-in, /app) lives
APP_URL="http://localhost:3100"
# Where each project's public portal lives. {project} is replaced by the slug,
# e.g. "https://{project}.tuti.so". Needs a wildcard DNS record.
# Locally, http://<project>.localhost:3100 always works too.
PORTAL_URL_TEMPLATE="http://{project}.localhost:3100"

# Hatchet (Hatchet Cloud or self-hosted): an API token from your Hatchet
# dashboard (Settings → API Tokens). The token carries the server address.
HATCHET_CLIENT_TOKEN=""
# Self-hosted only, if needed: other HATCHET_CLIENT_* settings, e.g.
# HATCHET_CLIENT_TLS_STRATEGY="none" for a server without TLS, or
# HATCHET_CLIENT_HOST_PORT="hatchet.example.com:443" to override the address.
# Or run background jobs inside the web app instead (no Hatchet, no worker,
# no retries); fine for small installs:
# JOBS_DRIVER="inline"

# Optional: duplicate detection with OpenAI text-embedding-3-small.
# Without it, posting works and duplicate detection is skipped.
OPENAI_API_KEY=""
# Optional: an OpenAI-compatible endpoint instead of https://api.openai.com/v1
# OPENAI_BASE_URL=""

# Optional: AI drafting (changelog entries from merged pull requests) and AI answers on the
# help center (these also need OPENAI_API_KEY, to find the articles to answer from) through
# OpenRouter, or any OpenAI-compatible chat completions API. Without a key, AI features are off.
# OPENROUTER_API_KEY=""
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL="anthropic/claude-haiku-5.5"   # any model the endpoint offers

# Email (verification, invites and "it shipped" emails) over SMTP, any provider. Without SMTP_HOST,
# emails are written to the server log instead of being sent.
# SMTP_HOST=""           # e.g. smtp.resend.com, email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT="587"        # 587 upgrades to TLS (STARTTLS); 465 is TLS from the start, but some hosts block it
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# EMAIL_FROM="Acme Feedback <feedback@example.com>"  # required with SMTP_HOST: an address your provider lets you send from

# Optional: the request header your proxy sets to the visitor's IP address, e.g. "cf-connecting-ip"
# behind Cloudflare. Portal sign-in links use it for a per-visitor hourly limit (only a keyed hash of
# the address is stored, for an hour). Only set it if your proxy always overwrites the header: without
# it there's no per-visitor limit (the per-address and per-portal limits still apply).
# TRUSTED_IP_HEADER=""

# Image uploads, to any S3-compatible storage (Cloudflare R2, AWS S3, MinIO, …).
# Without these, uploads are off. Browsers upload straight to the bucket, so its
# CORS rules must allow PUT from the app and portal origins. Serve the bucket from
# MEDIA_PUBLIC_URL, a separate host (e.g. media.example.com, never the app's own).
# MEDIA_S3_ENDPOINT=""          # e.g. https://<account>.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=""
# MEDIA_S3_ACCESS_KEY_ID=""
# MEDIA_S3_SECRET_ACCESS_KEY=""
# MEDIA_S3_REGION="auto"        # "auto" for R2; your bucket's region on S3
# MEDIA_PUBLIC_URL=""           # e.g. https://media.example.com
# Limits (defaults shown): per image for the team and for portal users, per project.
# MEDIA_MAX_IMAGE_MB_TEAM="10"
# MEDIA_MAX_IMAGE_MB_USER="5"
# MEDIA_PROJECT_QUOTA_MB="1024"

# GitHub (optional): a GitHub App lets projects link and close posts from pull
# requests and releases. All six GITHUB_APP_* / GITHUB_WEBHOOK_SECRET values are
# needed together (GitHub stays off until they're all set). Register one (Settings → Developer settings → GitHub Apps) with:
#   Setup URL: <APP_URL>/api/github/setup (leave "Request user authorization during installation" off)
#   Callback URL: <APP_URL>/api/github/callback (Tuti asks who installed, to check they can see the installation)
#   Webhook URL: <APP_URL>/api/github/webhook, with a webhook secret
#   Permissions: Pull requests (read; read and write to comment on them), Contents (read); events: Pull request, Release
# GITHUB_APP_SLUG=""            # from the App's public URL: github.com/apps/<slug>
# GITHUB_APP_CLIENT_ID=""
# GITHUB_APP_CLIENT_SECRET=""
# GITHUB_WEBHOOK_SECRET=""
# GITHUB_APP_ID=""               # the App's ID; with its private key, Tuti reads releases and pull requests
# GITHUB_APP_PRIVATE_KEY=""      # PEM; newlines may be written as \n
# GITHUB_URL="https://github.com"          # GitHub Enterprise: your server
# GITHUB_API_URL="https://api.github.com"
