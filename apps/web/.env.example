DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tuti"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Where the app (marketing, team sign-in, /app) lives
APP_URL="http://localhost:3100"
# Where each workspace's public portal lives. {workspace} is replaced by the slug,
# e.g. "https://{workspace}.tuti.so". Needs a wildcard DNS record.
# Locally, http://<workspace>.localhost:3100 always works too.
PORTAL_URL_TEMPLATE="http://{workspace}.localhost:3100"

# Hatchet Cloud (https://cloud.onhatchet.run) → Settings → API Tokens
HATCHET_CLIENT_TOKEN=""
