DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tuti"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Where the app (marketing, team sign-in, /app) lives
APP_URL="http://localhost:3100"
# Where each project's public portal lives. {project} is replaced by the slug,
# e.g. "https://{project}.tuti.so". Needs a wildcard DNS record.
# Locally, http://<project>.localhost:3100 always works too.
PORTAL_URL_TEMPLATE="http://{project}.localhost:3100"

# Hatchet Cloud (https://cloud.onhatchet.run) → Settings → API Tokens
HATCHET_CLIENT_TOKEN=""

# Optional: duplicate detection with OpenAI text-embedding-3-small.
# Without it, posting works and duplicate detection is skipped.
OPENAI_API_KEY=""
