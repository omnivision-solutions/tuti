DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tuti"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Where the app (marketing, team sign-in, /app) lives
APP_URL="http://localhost:3100"
# Where each project's public portal lives. {project} is replaced by the slug,
# e.g. "https://{project}.tuti.so". Needs a wildcard DNS record.
# Locally, http://<project>.localhost:3100 always works too.
PORTAL_URL_TEMPLATE="http://{project}.localhost:3100"

# Hatchet (Hatchet Cloud or self-hosted): an API token from your Hatchet
# dashboard (Settings → API Tokens). The token carries the server address.
HATCHET_CLIENT_TOKEN=""
# Self-hosted only, if needed: other HATCHET_CLIENT_* settings, e.g.
# HATCHET_CLIENT_TLS_STRATEGY="none" for a server without TLS, or
# HATCHET_CLIENT_HOST_PORT="hatchet.example.com:443" to override the address.
# Or run background jobs inside the web app instead (no Hatchet, no worker,
# no retries); fine for small installs:
# JOBS_DRIVER="inline"

# Optional: duplicate detection with OpenAI text-embedding-3-small.
# Without it, posting works and duplicate detection is skipped.
OPENAI_API_KEY=""
# Optional: an OpenAI-compatible endpoint instead of https://api.openai.com/v1
# OPENAI_BASE_URL=""

# Email (verification and invites) over SMTP, any provider. Without SMTP_HOST,
# emails are written to the server log instead of being sent.
# SMTP_HOST=""
# SMTP_PORT="587"          # 465 for TLS from the start
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# EMAIL_FROM="Tuti <team@example.com>"
