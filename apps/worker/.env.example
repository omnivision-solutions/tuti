DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tuti"

# Hatchet (Hatchet Cloud or self-hosted): an API token from your Hatchet
# dashboard (Settings → API Tokens). The token carries the server address.
HATCHET_CLIENT_TOKEN=""
# Self-hosted only, if needed: other HATCHET_CLIENT_* settings, e.g.
# HATCHET_CLIENT_TLS_STRATEGY="none" for a server without TLS, or
# HATCHET_CLIENT_HOST_PORT="hatchet.example.com:443" to override the address.

# Optional: duplicate detection with OpenAI text-embedding-3-small.
# Without it, posting works and duplicate detection is skipped.
OPENAI_API_KEY=""
# Optional: an OpenAI-compatible endpoint instead of https://api.openai.com/v1
# OPENAI_BASE_URL=""

# Optional: AI, the same settings as the web app: code changes (merged pull requests analysed
# into proposed actions) need OPENROUTER_API_KEY and OPENAI_API_KEY.
# OPENROUTER_API_KEY=""
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL="anthropic/claude-haiku-5.5"
# Each feature's model for every project, instead of AI_MODEL (a project's owners and admins can
# pick another in Settings → AI models):
# AI_MODEL_ANSWERS=""
# AI_MODEL_ESCALATIONS=""
# AI_MODEL_CHANGELOG=""
# AI_MODEL_CODE_CHANGES=""
# DECISION_MODEL="nace-ai/drex-max"
# AI credits: the same AI_CREDITS* settings as the web app (code changes are charged here).
# AI_CREDITS="on"

# Image uploads: the same MEDIA_S3_* settings as the web app (the worker processes
# uploaded images). Without them, uploads are off.
# MEDIA_S3_ENDPOINT=""
# MEDIA_S3_BUCKET=""
# MEDIA_S3_ACCESS_KEY_ID=""
# MEDIA_S3_SECRET_ACCESS_KEY=""
# MEDIA_S3_REGION="auto"

# Email over SMTP, the same settings as the web app: the worker emails people when
# their post ships. Without SMTP_HOST, emails are written to the log instead.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# EMAIL_FROM="Acme Feedback <feedback@example.com>"

# Portal URLs, as in the web app: webhook payloads and emails link to posts.
PORTAL_URL_TEMPLATE="https://{project}.example.com"
# Custom domains, as in the web app: set it here too, so links in emails and webhooks use a
# portal's own domain once it's live.
# CUSTOM_DOMAIN_TARGET=""
# Tuti's own portal on the app's domain, as in the web app (then APP_URL too).
# APP_PORTAL_PROJECT=""
# APP_URL=""

# GitHub App (optional, but needed whenever the web app has GitHub set up): the
# worker reads merged pull requests for code changes. Same values as the web app.
# GITHUB_APP_ID=""
# GITHUB_APP_PRIVATE_KEY=""
# GITHUB_API_URL="https://api.github.com"
