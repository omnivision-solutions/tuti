DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tuti"

# Hatchet (Hatchet Cloud or self-hosted): an API token from your Hatchet
# dashboard (Settings → API Tokens). The token carries the server address.
HATCHET_CLIENT_TOKEN=""
# Self-hosted only, if needed: other HATCHET_CLIENT_* settings, e.g.
# HATCHET_CLIENT_TLS_STRATEGY="none" for a server without TLS, or
# HATCHET_CLIENT_HOST_PORT="hatchet.example.com:443" to override the address.

# Optional: duplicate detection with OpenAI text-embedding-3-small.
# Without it, posting works and duplicate detection is skipped.
OPENAI_API_KEY=""
# Optional: an OpenAI-compatible endpoint instead of https://api.openai.com/v1
# OPENAI_BASE_URL=""
