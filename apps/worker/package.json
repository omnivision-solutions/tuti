{
  "name": "@tuti/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "backfill:embeddings": "tsx --env-file-if-exists=.env src/scripts/backfill-embeddings.ts"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "^1.33.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tuti/db": "workspace:*",
    "@tuti/jobs": "workspace:*",
    "@tuti/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "sharp": "^0.35.5",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tuti/typescript-config": "workspace:*",
    "@types/node": "^22",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^6.0.3"
  }
}
