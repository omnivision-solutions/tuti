{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "APP_URL",
    "PORTAL_URL_TEMPLATE",
    "ALLOWED_DEV_ORIGINS",
    "BETTER_AUTH_*",
    "HATCHET_CLIENT_*",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "JOBS_DRIVER",
    "SMTP_*",
    "INBOUND_*",
    "SUPPORT_EMAIL_DOMAIN",
    "EMAIL_FROM",
    "LICENSE_PRIVATE_KEY",
    "DOMAIN_CONNECT_KEY"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^db:generate",
        "db:generate"
      ]
    },
    "lint": {},
    "dev": {
      "dependsOn": [
        "^db:generate"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
