generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────
// Generated by Better Auth (`npx auth@1.7.7 generate`). Keep field names as-is;
// the domain back-relations on User are ours.

model User {
  id               String    @id
  name             String
  email            String
  emailVerified    Boolean   @default(false)
  image            String?
  /// Secret in unsubscribe links: whoever has it can stop a project's emails to this person.
  unsubscribeToken String    @unique @default(dbgenerated("gen_random_uuid()::text"))
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
  accounts         Account[]

  teamMemberships    TeamMember[]
  posts              Post[]
  votes              Vote[]
  comments           Comment[]
  changelogReactions ChangelogReaction[]
  changelogSeen      ChangelogSeen[]
  ssoIdentity        SsoIdentity?

  invitationsCreated  Invitation[]      @relation("InvitationCreatedBy")
  portalReadersAdded  PortalReader[]    @relation("PortalReaderAddedBy")
  customDomainsAdded  CustomDomain[]    @relation("CustomDomainAddedBy")
  invitationsAccepted Invitation[]      @relation("InvitationAcceptedBy")
  portalHandoffs      PortalHandoff[]
  apiKeysCreated      ApiKey[]
  webhooksCreated     Webhook[]
  media               Media[]
  emailOptOuts        EmailOptOut[]
  shippedEmails       ShippedEmail[]
  articleRevisions    ArticleRevision[]
  codeChangeActions   CodeChangeAction[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────
// Every domain table carries projectId so a single deployment can host many
// projects (and so self-hosters with one project pay nothing extra).

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

/// This installation of Tuti, one row (made by its migration): the random id licence keys are signed for.
model Installation {
  /// Always 1, so there's only ever one row.
  singleton    Int       @id @default(1)
  id           String    @unique
  /// The latest time tuti.so has said it is: keys expire by it too, so setting the clock back
  /// doesn't bring an expired one back.
  latestSeenAt DateTime?
  createdAt    DateTime  @default(now())

  @@map("installation")
}

model Project {
  id                    String       @id @default(cuid())
  slug                  String       @unique
  name                  String
  /// HS256 secret the project's own app uses to sign SSO tokens. SSO is
  /// enabled when this is set. Stored as-is because verification needs it.
  ssoSecret             String?
  /// Last post number handed out; posts are numbered #1, #2, … per project.
  postCount             Int          @default(0)
  /// Last changelog entry number handed out, like postCount.
  changelogCount        Int          @default(0)
  /// How the team's changelog reads, for AI drafts: tone notes, and up to 3
  /// published entries as examples (ids; deleted or unpublished ones are skipped).
  changelogTone         String       @default("")
  changelogExampleIds   String[]     @default([])
  /// AI edits to changelog entries (changelog.rewrite) in the hour that started at
  /// changelogAiHour, for the per-project hourly cap.
  changelogAiHour       DateTime     @default(now())
  changelogAiCount      Int          @default(0)
  /// The widget's launcher on customers' sites (see the widget.* operations): its
  /// label, colour (`#rrggbb`; null is the brand green, with its dark-mode shade),
  /// corner ("bottom-right" or "bottom-left"), and up to 5 quick links shown at the
  /// top of the panel (`[{ label, url }]`, https only).
  widgetLabel           String       @default("Feedback")
  widgetColor           String?
  widgetPosition        String       @default("bottom-right")
  widgetLinks           Json         @default("[]")
  /// Branding for the portal and its docs (see the branding.* operations): a logo,
  /// one for dark mode and a favicon (uploads, attached while they're used), the accent
  /// colour (`#rrggbb`; null is the brand green), up to 5 links each in the header and the
  /// footer (`[{ label, url }]`, https only), and whether the footer says "Powered by tuti".
  brandLogoId           String?
  brandLogoDarkId       String?
  brandFaviconId        String?
  brandColor            String?
  headerLinks           Json         @default("[]")
  footerLinks           Json         @default("[]")
  poweredBy             Boolean      @default(true)
  /// What readers can do with an article (Customize → Content actions): the menu at all, and in it
  /// copying it as Markdown and opening it in ChatGPT or Claude; and whether its page says when it
  /// was last updated.
  articleActions        Boolean      @default(true)
  articleCopyMarkdown   Boolean      @default(true)
  articleOpenChatGpt    Boolean      @default(true)
  articleOpenClaude     Boolean      @default(true)
  articleUpdatedDate    Boolean      @default(true)
  /// The docs' home (Customize → Docs home): a title and a subtitle above its search box (empty for
  /// "Docs" and the default line), and whether it lists the most-read articles.
  docsTitle             String       @default("")
  docsSubtitle          String       @default("")
  docsPopular           Boolean      @default(false)
  /// The portal's own search listing (Customize → SEO): its title (empty: the project's name), its
  /// description, and the image a link to it shows (an upload, like the logos).
  seoTitle              String       @default("")
  seoDescription        String       @default("")
  seoImageId            String?
  /// More of the look (Customize → Branding): light or dark mode for readers who haven't picked one
  /// ("system": their device's), text beside the logo (empty: none, or the project's name without a
  /// logo), and where the logo goes (null: the portal's home).
  colorScheme           String       @default("system")
  /// Fonts for headings and for text (Customize → Branding → Typography), from the portal fonts
  /// (apps/web/src/lib/portal-fonts.ts); empty for the page's own.
  /// The team's own code (Customize → Custom code): CSS on every portal page, and HTML (scripts,
  /// say analytics) at the end of the page only where the portal is on their own domain or site.
  customCss             String       @default("")
  customHtml            String       @default("")
  headingFont           String       @default("")
  bodyFont              String       @default("")
  logoText              String       @default("")
  logoLink              String?
  /// More links (Customize → Navigation): up to 5 above the docs' tree (`[{ label, url }]`, https
  /// only), and a "Contact us" button in the header (its label, empty for "Contact us"; its address,
  /// https or mailto:, null for none).
  sidebarLinks          Json         @default("[]")
  contactLabel          String       @default("")
  contactUrl            String?
  /// Tuti's licence key for this project on this installation (see server/license.ts). Without a
  /// valid one the footer says "Powered by tuti" whatever poweredBy says.
  licenseKey            String?
  /// Renewing that key from tuti.so (server/license-renewal.ts): the one-time token for the next
  /// renewal, the request id of an attempt whose answer hasn't arrived (a retry carries it), when an
  /// admin first asked for a licence (checks start then; a project nobody asked about never
  /// contacts tuti.so), and when it was last checked (at most daily, and one check at a time).
  licenseToken          String?
  licenseRequestId      String?
  licenseRequestedAt    DateTime?
  licenseCheckedAt      DateTime?
  /// Who may read the portal (see the portal.* operations and server/portal-access.ts): anyone, or
  /// when private only the project's team and the people its SSO signs in.
  portalAccess          PortalAccess @default(PUBLIC)
  /// What the portal's home (`/`) opens: the first board, the roadmap, the changelog or the docs.
  portalHome            PortalHome   @default(FEEDBACK)
  /// How the docs' AI answers (see the assistant.* operations): a tone, the answer
  /// length, standing instructions, and off-limits topics (short phrases; a question that
  /// contains one gets a fixed reply without asking the model).
  assistantTone         String       @default("")
  assistantLength       AnswerLength @default(MEDIUM)
  assistantInstructions String       @default("")
  assistantOffLimits    String[]     @default([])
  /// Where "Ask a person" sends questions the AI couldn't help with (docs.escalate): an
  /// address that confirmed a link we emailed it; null is off. A new address waits in
  /// supportEmailPending (with the hash of its link's token) until it's confirmed, and the
  /// confirmed one keeps working meanwhile.
  supportEmail          String?
  supportEmailPending   String?
  supportEmailTokenHash String?      @unique
  /// Merged pull requests become code changes (see CodeChange): on unless the team turned it off.
  analyseCodeChanges    Boolean      @default(true)
  /// Tuti applies a code change's "links" proposals by itself when it's this sure (AUTO_LINK), if the
  /// team opted in. Only links: completing posts, comments and docs always wait for someone.
  autoApplyLinks        Boolean      @default(false)
  /// The model the project picked for an AI feature, by feature (answers, escalations, changelog,
  /// code_changes): a model id; a feature that isn't here uses the server's default for it.
  aiModels              Json         @default("{}")
  /// AI credits charged beyond what the project's grants had left (a request already running when they ran
  /// out): taken from the next grant first. Only with AI credits on (see AiCreditGrant).
  aiCreditDebt          Decimal      @default(0) @db.Decimal(20, 6)
  /// When the project was given AI_CREDITS_FREE (once, the first time its credits were looked at).
  freeCreditsGrantedAt  DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  team                 TeamMember[]
  boards               Board[]
  posts                Post[]
  votes                Vote[]
  comments             Comment[]
  ssoIdentities        SsoIdentity[]
  ssoTokenUses         SsoTokenUse[]
  portalHandoffs       PortalHandoff[]
  signInLinks          SignInLink[]
  apiKeys              ApiKey[]
  githubInstallation   GithubInstallation?
  postLinks            PostLink[]
  webhooks             Webhook[]
  media                Media[]               @relation("projectMedia")
  brandLogo            Media?                @relation("brandLogo", fields: [brandLogoId], references: [id], onDelete: SetNull)
  brandLogoDark        Media?                @relation("brandLogoDark", fields: [brandLogoDarkId], references: [id], onDelete: SetNull)
  brandFavicon         Media?                @relation("brandFavicon", fields: [brandFaviconId], references: [id], onDelete: SetNull)
  seoImage             Media?                @relation("seoImage", fields: [seoImageId], references: [id], onDelete: SetNull)
  invitations          Invitation[]
  boardRedirects       BoardRedirect[]
  postEmbeddings       PostEmbedding[]
  duplicateSuggestions DuplicateSuggestion[]
  emailOptOuts         EmailOptOut[]
  changelogEntries     ChangelogEntry[]
  articles             Article[]
  articleChunks        ArticleChunk[]
  collections          Collection[]
  docsTabs             DocsTab[]
  readerGroups         ReaderGroup[]
  docsRedirects        DocsRedirect[]
  portalReaders        PortalReader[]
  portalReaderEmails   PortalReaderEmail[]
  customDomain         CustomDomain?
  siteMount            SiteMount?
  portalRedirects      PortalRedirect[]
  docsSearchDays       DocsSearchDay[]
  docsFailedSearchDays DocsFailedSearchDay[]
  docsQuestions        DocsQuestion[]
  docsGapDismissals    DocsGapDismissal[]
  changelogSeen        ChangelogSeen[]
  codeChanges          CodeChange[]
  aiUsage              AiUsage[]
  aiCreditGrants       AiCreditGrant[]

  @@map("project")
}

/// The team that manages a project. Users who vote and comment on its portal
/// are plain `User`s and aren't on the team.
model TeamMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("team_member")
}

// ─── SSO ─────────────────────────────────────────────────────────────────────

/// One of a project's users, as its app tells Tuti about them: signed in through the project's
/// JWT SSO (or the widget's), or named by the API (`author`, users.*). Users are matched by the
/// project's own user id (`sub`), never by email, so each (project, sub) gets
/// its own User and one project can't sign in as another project's users.
model SsoIdentity {
  id         String   @id @default(cuid())
  projectId  String
  /// The `sub` claim: the user's id in the project's app.
  externalId String
  userId     String   @unique
  /// Email as asserted by the project's app (User.email is a placeholder), lowercase. Someone signed
  /// in to the portal another way with this address, verified, has this user's groups too.
  email      String?
  /// Their `groups` property as it was kept before it was a property (the token's `groups`): written
  /// alongside it, and copied into it by a trigger when an instance from before writes it, so the two
  /// agree while a deploy overlaps them. Goes, with the trigger, in a later migration.
  legacyGroups String[] @default([]) @map("groups")
  /// What the project's app says about them (strings, numbers, booleans and lists of strings by name,
  /// up to 50; lib/user-properties.ts), set by SSO sign-ins and the API; matched against groups' conditions.
  /// The column keeps its old name, so app instances from before it keep working while a deploy overlaps them.
  properties Json     @default("{}") @map("attributes")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalId])
  @@index([projectId, email])
  @@map("sso_identity")
}

/// Token ids (`jti`) already used, so a token can't be replayed. Rows are only
/// needed until the token would have expired anyway.
model SsoTokenUse {
  projectId String
  jti       String
  expiresAt DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, jti])
  @@index([expiresAt])
  @@map("sso_token_use")
}

enum MediaStatus {
  /// Waiting for the browser to upload the file.
  UPLOADING
  /// Uploaded; the image job is checking and re-encoding it.
  PROCESSING
  READY
  /// Not an image we accept, or processing failed. The file is gone.
  FAILED
}

/// An uploaded image (see @tuti/content media.ts for where its files live).
model Media {
  id         String      @id @default(cuid())
  projectId  String
  uploaderId String
  status     MediaStatus @default(UPLOADING)
  /// Bytes counted against the project's quota: the declared upload size until
  /// processed, then the size of the files kept.
  size       Int
  /// After processing (longest side at most 2400px).
  width      Int?
  height     Int?
  /// Set (again) whenever content using it is saved; cleared by the release-media job once
  /// no content uses it. Uploads without it are deleted a day after they were uploaded.
  attachedAt DateTime?
  createdAt  DateTime    @default(now())

  project    Project   @relation("projectMedia", fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  /// Projects whose branding uses it (see Project.brandLogoId).
  logoOf     Project[] @relation("brandLogo")
  logoDarkOf Project[] @relation("brandLogoDark")
  faviconOf  Project[] @relation("brandFavicon")
  seoImageOf Project[] @relation("seoImage")

  @@index([projectId])
  @@index([uploaderId, createdAt])
  @@index([attachedAt, createdAt])
  @@map("media")
}

enum ApiKeyScope {
  READ
  /// Read and write.
  WRITE
}

/// A project's key for the REST API and MCP. The key is shown once; only its hash is stored.
model ApiKey {
  id              String      @id @default(cuid())
  projectId       String
  name            String
  scope           ApiKeyScope
  keyHash         String      @unique
  /// The key's first characters, so people can tell keys apart (tuti_ab12…).
  prefix          String
  createdById     String
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  /// Requests in the current minute, for the per-key rate limit.
  rateWindowStart DateTime?
  rateCount       Int         @default(0)
  createdAt       DateTime    @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("api_key")
}

enum PostLinkKind {
  PULL_REQUEST
  ISSUE
  RELEASE
}

enum PostLinkSource {
  /// Added by the team on the post.
  MANUAL
  /// Mentioned in a pull request (tuti#123 or the post's URL).
  REFERENCE
  /// Suggested by text similarity and confirmed by the team.
  SUGGESTED
  /// Written by a code change's action the team applied (`codeChangeId`).
  CODE_CHANGE
}

/// A post's link to GitHub: the pull request, issue or release that works on or ships it.
model PostLink {
  id          String         @id @default(cuid())
  projectId   String
  postId      String
  kind        PostLinkKind
  /// owner/name
  repo        String
  /// PR or issue number; null for releases.
  number      Int?
  /// Release tag; null otherwise.
  tag         String?
  url         String
  /// From GitHub once the app is connected (null when added by hand).
  title       String?
  source       PostLinkSource
  /// The code change whose applied action wrote it (source CODE_CHANGE).
  codeChangeId String?
  createdById  String?
  createdAt    DateTime       @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post       Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  codeChange CodeChange? @relation(fields: [codeChangeId], references: [id], onDelete: SetNull)

  @@unique([postId, url])
  @@index([projectId, repo, number])
  @@map("post_link")
}

/// An endpoint that gets a project's events (signed, retried; see packages/jobs/src/webhooks.ts).
model Webhook {
  id          String   @id @default(cuid())
  projectId   String
  url         String
  /// Signs every delivery (HMAC-SHA256). Shown once when the webhook is created.
  secret      String
  /// Event types it gets, e.g. "post.created".
  events      String[]
  createdById String
  createdAt   DateTime @default(now())

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId])
  @@map("webhook")
}

/// One event for one webhook. `eventId` is the same on every retry, so receivers can skip repeats.
model WebhookDelivery {
  id          String    @id @default(cuid())
  webhookId   String
  eventId     String
  event       String
  payload     Json
  attempts    Int       @default(0)
  /// HTTP status of the last attempt (null when it didn't get a response).
  lastStatus  Int?
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_delivery")
}

/// A project's connection to a GitHub App installation (a GitHub user or organisation). Several
/// projects may connect the same installation; the team adds each one's repositories
/// (GithubRepository), and only those repositories' pull requests and releases reach it.
model GithubInstallation {
  id             String   @id @default(cuid())
  projectId      String   @unique
  installationId Int
  /// The GitHub user or organisation it's installed on.
  accountLogin   String
  /// GitHub's type for that account: "Organization" or "User" (their settings live at different addresses).
  accountType    String   @default("Organization")
  /// The installation's repositories listed in this project's settings ([{ id, fullName }]): every
  /// one the Tuti app can see on the account, as of the last refresh. Only these can be added.
  repositories   Json     @default("[]")
  createdById    String
  createdAt      DateTime @default(now())

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  included GithubRepository[]

  @@index([installationId])
  @@map("github_installation")
}

/// A repository the team added to a project: its pull requests and releases link to and close that
/// project's posts. One project per repository, so `tuti#12` in it always means one post.
model GithubRepository {
  id           String   @id @default(cuid())
  connectionId String
  /// GitHub's id for it: stays the same when it's renamed or transferred.
  repoId       Int      @unique
  /// owner/name, as last heard from GitHub.
  fullName     String
  createdAt    DateTime @default(now())

  connection GithubInstallation @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("github_repository")
}

/// "Continue as <name>": a one-time code from the app host that signs a Tuti
/// account into one portal. Bound to the portal and to the state cookie of the
/// browser that asked for it; deleted when used. Only hashes are stored.
/// Someone the team lets read its private portal without being on the team or signed in by its
/// SSO: any account with this email, once the email is verified (an emailed sign-in link verifies it).
model PortalReader {
  id        String   @id @default(cuid())
  projectId String
  /// Lowercase.
  email     String
  addedById String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("PortalReaderAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([projectId, email])
  @@map("portal_reader")
}

enum CertificateStatus {
  PENDING
  ACTIVE
  FAILED
}

/// A portal under a path of the team's own site (https://acme.com/portal), one per project: the
/// site forwards that path to the portal's Tuti address, path and all, and Tuti adds the path to
/// every link and redirect there. It's used once verified: the site, fetched through that path,
/// answers with this project's token, so the forwarding reaches this portal.
/// An old address on a project's portal sent on to a new one (Customize → Redirects): `from` is a
/// path of the portal ("/hc/en-us/articles/123"), `to` a path of it or a whole https address.
model PortalRedirect {
  id        String   @id @default(cuid())
  projectId String
  from      String
  to        String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, from])
  @@map("portal_redirect")
}

model SiteMount {
  id                String    @id @default(cuid())
  projectId         String    @unique
  /// The site's origin, e.g. https://acme.com.
  origin            String
  /// Where the portal is on it, e.g. /portal: one or more lowercase segments, no trailing slash.
  path              String
  verificationToken String
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("site_mount")
}

/// A portal's own domain (help.acme.com) in place of <project>.tuti.so, one per project. It serves
/// the portal once verified: a TXT record at _tuti.<hostname> with this project's token shows the
/// team controls the domain's DNS. The hostname is unique only among verified ones, so adding
/// someone else's domain first can't keep them from using it.
model CustomDomain {
  id                String             @id @default(cuid())
  projectId         String             @unique
  /// Lowercase ASCII (international names as punycode), no port.
  hostname          String
  /// Goes in the TXT record, so not a secret: it ties the record to this project.
  verificationToken String
  verifiedAt        DateTime?
  /// Its custom hostname at Cloudflare for SaaS (made once it's verified, when the server uses
  /// Cloudflare for customers' certificates), and that certificate's status: PENDING until
  /// Cloudflare has it (the CNAME must point at CUSTOM_DOMAIN_TARGET), then ACTIVE, or FAILED.
  cloudflareId      String?            @unique
  certificate       CertificateStatus?
  addedById         String?
  createdAt         DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("CustomDomainAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([hostname], where: raw("\"verifiedAt\" IS NOT NULL"))
  @@map("custom_domain")
}

/// An email to a new reader of a private portal, kept a day for the send limits (per project, and
/// per address across projects), so removing and adding someone again can't send more.
model PortalReaderEmail {
  id        String   @id @default(cuid())
  /// Null once the project is deleted: the row still counts for the address.
  projectId String?
  /// SHA-256 of the lowercase address (hashSecret, as sign_in_link), not the address.
  emailHash String
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([emailHash, createdAt])
  /// For deleting the expired ones.
  @@index([createdAt])
  @@map("portal_reader_email")
}

model PortalHandoff {
  codeHash  String   @id
  projectId String
  userId    String
  stateHash String
  expiresAt DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("portal_handoff")
}

/// A sign-in link a portal emailed (magic link) or a password reset link the app
/// or a portal emailed (the token itself is Better Auth's verification row).
/// projectId is the portal it was asked on, null for the app host. Kept for an
/// hour: for the hourly limits per address, per visitor and per site (both kinds
/// count together), and to check a link is only used on the host that sent it.
/// Only hashes are stored (tokenHash is set once the link is made;
/// clientHash is an HMAC of the visitor's IP address, keyed with the auth secret,
/// and null without TRUSTED_IP_HEADER).
model SignInLink {
  id         String   @id @default(cuid())
  projectId  String?
  emailHash  String
  clientHash String?
  tokenHash  String?  @unique
  createdAt  DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([emailHash, createdAt])
  @@index([clientHash, createdAt])
  @@index([projectId, createdAt])
  @@map("sign_in_link")
}

/// A single-use link that adds someone to a project with a given role.
/// Only a hash of the token is stored; the link is shown once when created.
model Invitation {
  id           String    @id @default(cuid())
  projectId    String
  /// Who it's for (lowercase): only an account with this email can accept. Null for older link-only invites.
  email        String?
  role         TeamRole  @default(MEMBER)
  tokenHash    String    @unique
  createdById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, email])
  @@map("invitation")
}

// ─── Feedback ────────────────────────────────────────────────────────────────

enum PostStatus {
  OPEN
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

model Board {
  id                 String   @id @default(cuid())
  projectId          String
  slug               String
  name               String
  description        String?
  /// The board's own words for posting (null: the defaults): the button that opens the form, and the form's placeholders.
  postButton         String?
  titlePlaceholder   String?
  detailsPlaceholder String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  posts     Post[]
  redirects BoardRedirect[]

  @@unique([projectId, slug])
  @@map("board")
}

/// A board's previous URL, so links keep working after its slug changes.
/// Freed up when a board takes the slug again.
model BoardRedirect {
  id        String   @id @default(cuid())
  projectId String
  boardId   String
  slug      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([boardId])
  @@map("board_redirect")
}

model Post {
  id                 String     @id @default(cuid())
  projectId          String
  boardId            String
  authorId           String
  /// Per-project number (#123), used in URLs: /p/<title>-<number>.
  number             Int
  title              String
  /// Plain text of the post (derived from `content`), for previews, search and embeddings.
  body               String     @default("")
  /// The post as rich content (@tuti/content "post" profile, ProseMirror JSON).
  /// Null for posts written before rich text: their `body` is the plain text.
  content            Json?
  status             PostStatus @default(OPEN)
  /// Denormalised so boards can sort by votes without a COUNT per row.
  voteCount          Int        @default(0)
  commentCount       Int        @default(0)
  /// Set when this post is merged into another one; votes move to the original.
  duplicateOfId      String?
  /// Set when the post is completed, cleared once everyone is emailed; the shipped-emails-resubmit cron re-runs late ones.
  shippedEmailsDueAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board                  Board                 @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author                 User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  duplicateOf            Post?                 @relation("PostDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates             Post[]                @relation("PostDuplicates")
  shippedEmails          ShippedEmail[]
  changelogEntries       ChangelogEntryPost[]
  votes                  Vote[]
  comments               Comment[]
  embedding              PostEmbedding?
  duplicateSuggestions   DuplicateSuggestion[] @relation("SuggestedDuplicate")
  duplicateOfSuggestions DuplicateSuggestion[] @relation("SuggestedOriginal")

  links             PostLink[]
  codeChangeActions CodeChangeAction[]

  @@unique([projectId, number])
  /// Trigram index for "similar posts" suggestions (pg_trgm).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "post_title_trgm_idx")
  @@index([boardId, voteCount(sort: Desc)])
  @@index([boardId, createdAt(sort: Desc)])
  @@index([projectId, status])
  @@index([duplicateOfId])
  @@index([shippedEmailsDueAt])
  @@map("post")
}

model Vote {
  postId    String
  userId    String
  projectId String
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("vote")
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  postId    String
  authorId  String
  /// Plain text (derived from `content`).
  body      String
  /// Rich content (@tuti/content "comment" profile); null for comments from before rich text.
  content   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comment")
}

// ─── Duplicate detection ─────────────────────────────────────────────────────

/// OpenAI text-embedding-3-small vector of a post's title + body (pgvector).
/// `contentHash` tells when the text changed and needs re-embedding.
model PostEmbedding {
  postId      String                      @id
  projectId   String
  model       String
  contentHash String
  embedding   Unsupported("vector(1536)")
  updatedAt   DateTime                    @updatedAt

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("post_embedding")
}

enum DuplicateSuggestionStatus {
  PENDING
  DISMISSED
}

/// "This post may duplicate that older one", for the team to merge or dismiss.
model DuplicateSuggestion {
  id         String                    @id @default(cuid())
  projectId  String
  /// The newer post, which would be merged…
  postId     String
  /// …into this older one.
  originalId String
  similarity Float
  status     DuplicateSuggestionStatus @default(PENDING)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post     Post    @relation("SuggestedDuplicate", fields: [postId], references: [id], onDelete: Cascade)
  original Post    @relation("SuggestedOriginal", fields: [originalId], references: [id], onDelete: Cascade)

  @@unique([postId, originalId])
  @@index([projectId, status])
  @@index([originalId])
  @@map("duplicate_suggestion")
}

/// Someone who unsubscribed from a project's emails.
model EmailOptOut {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("email_opt_out")
}

/// Emailing someone that a post shipped: claimed, then sent (once per post and person).
model ShippedEmail {
  postId    String
  userId    String
  /// When a run took this person on; an unsent claim this old is a crashed run's, and is taken over.
  claimedAt DateTime  @default(now())
  sentAt    DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("shipped_email")
}

// ─── Changelog (Phase 8) ─────────────────────────────────────────────────────

enum ChangelogTag {
  NEW
  IMPROVED
  FIXED
  BREAKING
}

/// A changelog entry: a draft the team writes, then publishes on the portal's /changelog.
model ChangelogEntry {
  id          String         @id @default(cuid())
  projectId   String
  /// Per-project number, like posts.
  number      Int
  title       String
  /// Plain text of the entry (derived from `content`).
  body        String         @default("")
  /// Rich content (@tuti/content "changelog" profile).
  content     Json?
  tags        ChangelogTag[]
  /// Null while it's a draft.
  publishedAt DateTime?
  /// Published with an announcement (the widget shows it as new), or quietly.
  announced   Boolean        @default(false)
  /// The running draft: merged pull requests are added to it until a release (or
  /// publishing it) closes it. At most one per project (a partial unique index).
  collecting  Boolean        @default(false)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  posts        ChangelogEntryPost[]
  pullRequests ChangelogEntryPullRequest[]
  reactions    ChangelogReaction[]

  @@unique([projectId, number])
  @@index([projectId, publishedAt])
  @@map("changelog_entry")
}

enum ChangelogReactionKind {
  THUMBS_UP
  HEART
  TADA
}

/// A reader's reaction to a published changelog entry: one of each kind per person.
model ChangelogReaction {
  entryId   String
  userId    String
  kind      ChangelogReactionKind
  createdAt DateTime              @default(now())

  entry ChangelogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([entryId, userId, kind])
  @@index([userId])
  @@map("changelog_reaction")
}

/// How far someone has read a project's announcements (What's new in the widget, the
/// portal's /changelog): announced entries published after `seenAt` are new to them.
/// Only ever moves forward, so seeing them on one device clears them on the others.
model ChangelogSeen {
  projectId String
  userId    String
  seenAt    DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("changelog_seen")
}

/// A post a changelog entry completes ("Shipped in …").
model ChangelogEntryPost {
  entryId String
  postId  String

  entry ChangelogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  post  Post           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([entryId, postId])
  @@index([postId])
  @@map("changelog_entry_post")
}

/// A merged pull request added to a changelog entry's running draft (once each).
model ChangelogEntryPullRequest {
  entryId   String
  url       String
  /// owner/name
  repo      String
  number    Int
  title     String
  createdAt DateTime @default(now())

  entry ChangelogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, url])
  @@map("changelog_entry_pull_request")
}

/// A docs collection: a group of articles on the portal's /docs.
model Collection {
  id          String     @id @default(cuid())
  projectId   String
  /// From the name; no other collection, tab or (live) article in the project has it, so /docs/<slug> is one page.
  slug        String
  name        String
  description String     @default("")
  /// Among its siblings (same parent), collections are listed by this, then by name; new ones go last.
  order       Int        @default(0)
  /// The collection it's in, in the same project. At most 2 levels: a collection with a parent has
  /// no children (checked under the project's lock). Deleting the parent moves its children up a level.
  parentId    String?
  /// The docs tab a top-level collection is in; null inside another collection (it's in its
  /// parent's). Once a project has tabs, every top-level collection is in one (kept under the
  /// project's lock); without any, all are null.
  tabId       String?
  /// A Lucide icon by name (kebab-case, e.g. "credit-card"), checked against the installed Lucide
  /// when set. One Lucide later drops draws nothing.
  icon        String?
  /// Who may read it (and what's in it), on top of its tab and the collections it's in.
  access      ReadAccess @default(INHERIT)
  /// What people it isn't for see of it (see NoAccess).
  noAccess    NoAccess   @default(INHERIT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Collection?       @relation("CollectionParent", fields: [parentId], references: [id], onDelete: SetNull)
  tab       DocsTab?          @relation(fields: [tabId], references: [id], onDelete: SetNull)
  children  Collection[]      @relation("CollectionParent")
  articles  Article[]
  revisions ArticleRevision[]
  changes   ArticleChanges[]
  /// With `access` GROUPS: the groups whose readers may read it (none: only the team).
  groups    CollectionGroup[]
  redirects DocsRedirect[]
  /// Tabs that show it at their path.
  landingOf DocsTab[]         @relation("DocsTabLanding")

  @@unique([projectId, slug])
  @@index([parentId])
  @@index([tabId])
  @@map("collection")
}

/// A group of readers (Settings → Groups): the project's users whose properties match its conditions,
/// worked out when they read. Docs tabs, collections and articles can be for some groups only.
model ReaderGroup {
  id          String   @id @default(cuid())
  projectId   String
  /// From the name when it's made, unique in the project and never changed: how the API and
  /// collections name it (`/groups/{key}`, `groups` on collections.*).
  key         String
  name        String
  /// Matched against the project's users' properties, all of them (lib/group-conditions.ts GroupCondition[]).
  conditions  Json     @default("[]")
  /// The name a token's `groups` gave it before groups came only from conditions; cleared when its
  /// conditions change, and turned into one by a trigger when an instance from before writes it,
  /// while a deploy overlaps them. Goes, with the trigger, in a later migration.
  legacyClaim String?  @map("claim")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tabs        TabGroup[]
  collections CollectionGroup[]
  articles    ArticleGroup[]

  @@unique([projectId, key])
  @@map("reader_group")
}

/// Who may read a tab, a collection or an article, on top of everything above it (the tab, then
/// each collection, then the article): a page is readable when every level allows it, so a level
/// can only narrow what's above. The team reads everything. See apps/web lib/reader-groups.ts.
enum ReadAccess {
  /// What the level above allows (for a tab: everyone who may read the portal).
  INHERIT
  /// Anyone signed in on the portal.
  SIGNED_IN
  /// Readers in one of its groups (its *Group rows); with none, only the team.
  GROUPS
}

/// What people a tab, collection or article isn't for (by its ReadAccess) see of it. The nearest
/// level that isn't INHERIT decides, from the page up (the article, each collection, the tab); with
/// none, HIDE. See apps/web lib/read-access.ts.
enum NoAccess {
  /// As the level above (for a tab: HIDE).
  INHERIT
  /// Listed by its title with a lock; its page shows the title and asks them to sign in, or says
  /// they don't have access, never its content.
  LOCK
  /// Not listed anywhere, and its link is "not found".
  HIDE
}

/// A group a tab is for (with `access` GROUPS). A group in use can't be deleted, as for CollectionGroup.
model TabGroup {
  tabId   String
  groupId String

  tab   DocsTab     @relation(fields: [tabId], references: [id], onDelete: Cascade)
  group ReaderGroup @relation(fields: [groupId], references: [id], onDelete: NoAction)

  @@id([tabId, groupId])
  @@index([groupId])
  @@map("tab_group")
}

/// A group an article is for (with `access` GROUPS). A group in use can't be deleted, as for CollectionGroup.
model ArticleGroup {
  articleId String
  groupId   String

  article Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  group   ReaderGroup @relation(fields: [groupId], references: [id], onDelete: NoAction)

  @@id([articleId, groupId])
  @@index([groupId])
  @@map("article_group")
}

/// A group a collection is for (with `access` GROUPS). A group in use can't be deleted (NO ACTION,
/// checked at the end of the statement, so deleting the project, which takes both, still works):
/// the team takes it off first, so who may read what never changes behind their back.
model CollectionGroup {
  collectionId String
  groupId      String

  collection Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  group      ReaderGroup @relation(fields: [groupId], references: [id], onDelete: NoAction)

  @@id([collectionId, groupId])
  @@index([groupId])
  @@map("collection_group")
}

/// A tab of the docs ("Guides", "API"), with top-level collections in it. The first one also
/// lists the articles in no collection.
model DocsTab {
  id                  String      @id @default(cuid())
  projectId           String
  /// From the name; no other tab, collection or (live) article in the project has it, so /docs/<slug> is one page.
  slug                String
  name                String
  /// Tabs are listed by this, then by name; new ones go last.
  order               Int         @default(0)
  /// Who may read it: its collections and, on the first tab, the articles in no collection.
  access              ReadAccess  @default(INHERIT)
  /// What people it isn't for see of it (see NoAccess).
  noAccess            NoAccess    @default(INHERIT)
  /// What the tab's path shows (see DocsLanding).
  landing             DocsLanding @default(OVERVIEW)
  /// With PAGE: the article or the collection (at most one, a check constraint) it shows. Gone,
  /// unpublished, restricted or in another tab, it's the overview, for that reader.
  landingArticleId    String?
  landingCollectionId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collections       Collection[]
  redirects         DocsRedirect[]
  landingArticle    Article?       @relation("DocsTabLanding", fields: [landingArticleId], references: [id], onDelete: SetNull)
  landingCollection Collection?    @relation("DocsTabLanding", fields: [landingCollectionId], references: [id], onDelete: SetNull)
  /// With `access` GROUPS: the groups whose readers may read it (none: only the team).
  groups            TabGroup[]

  @@unique([projectId, slug])
  @@index([landingArticleId])
  @@index([landingCollectionId])
  @@map("docs_tab")
}

/// What a docs tab's path (/docs for the first, /docs/<tab> the others) shows.
enum DocsLanding {
  /// Search, a card per top-level collection and, on the first tab, the articles in none.
  OVERVIEW
  /// Its first article in reading order.
  FIRST
  /// The article or collection the team picked (landingArticleId or landingCollectionId).
  PAGE
}

/// A slug a tab, collection or article had, so /docs/<slug> keeps working after it's renamed: it
/// points at the page (exactly one of the three, a check constraint), not at its slug, so renaming
/// again makes no chain. A page taking the slug drops it (freeDocsSlug); until then a page that has it
/// wins (a deleted article restored under another slug leaves one behind its old one).
model DocsRedirect {
  id           String   @id @default(cuid())
  projectId    String
  slug         String
  tabId        String?
  collectionId String?
  articleId    String?
  createdAt    DateTime @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tab        DocsTab?    @relation(fields: [tabId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  article    Article?    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([tabId])
  @@index([collectionId])
  @@index([articleId])
  @@map("docs_redirect")
}

/// A docs article, at /docs/<slug> on the portal once it's published.
/// Where a published article is served. A draft is served nowhere, whatever it says.
enum ArticleListing {
  /// Its page, the docs' lists, search, the sitemap, llms.txt and AI answers.
  EVERYWHERE
  /// Readable by its link (page and .md) and cited by AI answers, but in no list, search, sitemap or llms.txt.
  UNLISTED
  /// Kept published but served nowhere public: no page, list, search or AI answers.
  HIDDEN
  /// Only a source for AI answers, which name it without a link: no page, list or search.
  AI_ONLY
}

model Article {
  id              String         @id @default(cuid())
  projectId       String
  /// From the title (or the team's, with `customSlug`); no other live article, tab or collection in the
  /// project has it, so /docs/<slug> is one page. Follows the title while it's a draft, unless it's custom.
  slug            String
  /// The team set the slug: it no longer follows the title, even on a draft.
  customSlug      Boolean        @default(false)
  /// The meta description (up to 300 characters); empty: from the text.
  description     String         @default("")
  /// Words readers search for that the text doesn't have (up to 20, of up to 60 characters): search
  /// matches them like the text, and they're embedded with its first section.
  keywords        String[]       @default([])
  /// "Block search indexing": robots noindex, and left out of the sitemap and llms.txt (still listed in the docs and search).
  noindex         Boolean        @default(false)
  title           String
  /// Plain text of the article (derived from `content`).
  body            String         @default("")
  /// Rich content (@tuti/content "article" profile).
  content         Json?
  /// Null while it's a draft.
  publishedAt     DateTime?
  /// Set when it's deleted: the team can restore it (as a draft) for 30 days, then the
  /// `purge-articles` job removes it. A deleted article is never published (a check
  /// constraint), so everything that reads published articles leaves it out, and its
  /// slug is free for other articles.
  deletedAt       DateTime?
  /// Show "Updated <date>" on the portal when it was edited after it was published.
  showUpdatedDate Boolean        @default(true)
  /// Where a published article is served (see ArticleListing). Changed at once, never kept
  /// as an unpublished change: it says who may read the article, not what it says.
  listing         ArticleListing @default(EVERYWHERE)
  /// Who may read it, on top of its collections and their tab (in no collection: the first tab's).
  /// Like `listing`, changed at once, never kept as an unpublished change.
  access          ReadAccess     @default(INHERIT)
  /// What people it isn't for see of it (see NoAccess); like `access`, changed at once.
  noAccess        NoAccess       @default(INHERIT)
  /// When changes to it last went live while it was published: the portal's "Updated" date.
  revisedAt       DateTime?
  /// At most one collection; deleting it leaves its articles uncollected.
  collectionId    String?
  /// Among the articles in its collection (or in none), listed by this, then by title; new ones go last.
  order           Int            @default(0)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collection Collection?       @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  chunks     ArticleChunk[]
  feedback   ArticleFeedback[]
  viewDays   ArticleViewDay[]
  revisions  ArticleRevision[]
  changes    ArticleChanges?
  redirects  DocsRedirect[]
  /// With `access` GROUPS: the groups whose readers may read it (none: only the team).
  groups     ArticleGroup[]
  /// Tabs that show it at their path.
  landingOf  DocsTab[]         @relation("DocsTabLanding")
  codeChangeActions CodeChangeAction[]

  @@unique([projectId, slug], where: raw("\"deletedAt\" IS NULL"))
  @@index([collectionId])
  @@index([deletedAt])
  @@map("article")
}

/// A saved version of an article: every save that changes its title, text or collection adds
/// one (the newest is the current version). Restoring an old one saves it again as a new one.
/// Only the newest ARTICLE_REVISIONS_KEPT (apps/web operations/docs.ts) are kept.
model ArticleRevision {
  id           String   @id @default(cuid())
  articleId    String
  title        String
  /// Plain text (derived from `content`), what the history's diff compares.
  body         String   @default("")
  content      Json?
  collectionId String?
  /// The person who saved it (an API key's creator for API saves).
  authorId     String?
  createdAt    DateTime @default(now())

  article    Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([collectionId])
  @@index([authorId])
  @@map("article_revision")
}

/// Unpublished changes to a published article: saving a published article keeps its title,
/// text and collection here, and readers (the portal, search, AI answers, the sitemap, …) keep
/// the published version in `article` until the team publishes the changes or discards them.
/// Each save is still a revision. Only published articles have them: unpublishing or deleting
/// an article makes them its draft's text.
model ArticleChanges {
  articleId    String   @id
  title        String
  /// Plain text (derived from `content`).
  body         String   @default("")
  content      Json?
  collectionId String?
  updatedAt    DateTime @updatedAt

  article    Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@map("article_changes")
}

/// A reader's answer to "Was this helpful?" under a published article: one per reader
/// and article, the latest answer wins. No IP addresses or user agents.
model ArticleFeedback {
  articleId String
  /// The signed-in user's id (or the user an API key answered for), or an anonymous
  /// reader's first-party cookie id (a random UUID).
  readerId  String
  helpful   Boolean
  /// What was missing; only with a "No".
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, readerId])
  @@map("article_feedback")
}

/// How often an article's portal page was viewed on a day (UTC): a counter per article
/// and day, not a row per view.
model ArticleViewDay {
  articleId String
  day       DateTime @db.Date
  views     Int

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day])
  @@map("article_view_day")
}

/// How many docs searches a project had on a day (UTC), and how many found nothing:
/// counters, not a row per search. No search's words (see DocsFailedSearchDay) and
/// nothing about who searched. Kept for the insights' 30 days (the prune-docs-searches job).
model DocsSearchDay {
  projectId String
  day       DateTime @db.Date
  searches  Int
  failed    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, day])
  @@map("docs_search_day")
}

/// What readers searched for that found nothing, normalized, with how often on a day
/// (UTC): the only searches whose words are kept, for the insights' failed searches. Up
/// to 100 different ones per project and day (more still count in DocsSearchDay); kept
/// for the insights' 30 days (the prune-docs-searches job).
model DocsFailedSearchDay {
  projectId String
  day       DateTime @db.Date
  query     String
  count     Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, day, query])
  @@map("docs_failed_search_day")
}

/// What became of a question asked of the docs' AI.
enum DocsAnswerStatus {
  /// Answered from the project's published articles, with sources.
  ANSWERED
  /// "I don't know": no section was relevant enough, or the model cited none.
  NO_ANSWER
  /// The embeddings or the model failed or took too long. Also a question's status while it's being answered.
  FAILED
}

/// Why a question got "I don't know" (NO_ANSWER), so the log's labels mean one thing.
enum DocsNoAnswerCause {
  /// No published section was close enough; the model wasn't asked.
  NO_RELEVANT_SECTION
  /// The model gave no answer, or cited none of the sections it was given.
  NO_VALID_CITATION
  /// An article it cited was unpublished or hidden while the model wrote.
  SOURCE_UNPUBLISHED
  /// The question names one of the project's off-limits topics; the model wasn't asked.
  OFF_LIMITS
  /// The project was out of AI credits (logged as failed, not "I don't know"); the model wasn't asked.
  NO_CREDITS
  /// Asked before causes were recorded.
  UNKNOWN
}

/// Who may read a project's portal.
enum PortalAccess {
  PUBLIC
  PRIVATE
}

enum PortalHome {
  FEEDBACK
  ROADMAP
  CHANGELOG
  DOCS
}

/// How long the docs' AI answers are (each is a sentence in the prompt and a cap on the reply).
enum AnswerLength {
  SHORT
  MEDIUM
  DETAILED
}

/// Where a question to the docs' AI was asked.
enum DocsQuestionSource {
  /// The portal's /docs.
  PORTAL
  /// The widget's Docs tab.
  WIDGET
  /// docs.ask (REST or MCP).
  API
}

/// A question asked of the docs' AI (docs.ask) and the asker's thumbs up or down:
/// what the team's Gaps list reads, and what the hourly rate limits count.
/// No IP addresses.
model DocsQuestion {
  id          String             @id @default(cuid())
  projectId   String
  /// The signed-in user's id, an anonymous reader's first-party cookie id, or the API key's id.
  askerId     String
  question    String
  source      DocsQuestionSource
  status      DocsAnswerStatus   @default(FAILED)
  /// Why it's "I don't know" (NO_ANSWER only).
  cause       DocsNoAnswerCause?
  answer      String?
  /// The articles the answer cites.
  articleIds  String[]           @default([])
  /// The asker's thumbs up (true) or down (false) on an answer.
  helpful     Boolean?
  /// The question it follows up on, in a conversation with the docs' AI (asked by the same asker): earlier turns
  /// are its context.
  followsId   String?
  /// When the asker passed it to the team ("Ask a person", docs.escalate), and the support address it went to.
  escalatedAt DateTime?
  escalatedTo String?
  createdAt   DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, askerId, createdAt])
  @@map("docs_question")
}

/// A question the team dismissed from the Gaps list: hidden as asked up to `dismissedAt`
/// (asked again later, it's back).
model DocsGapDismissal {
  projectId   String
  /// Normalized like the Gaps list groups questions: lowercase, trimmed, spaces collapsed.
  question    String
  dismissedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, question])
  @@map("docs_gap_dismissal")
}

/// A section of a published article (a heading and the text up to the next one, capped
/// in length) with its embedding, for search and AI answers. Only published articles
/// have chunks; a background job replaces all of an article's when its text changes.
model ArticleChunk {
  id          String                      @id @default(cuid())
  articleId   String
  projectId   String
  /// Order in the article, from 0.
  position    Int
  /// The section's heading; "" for text before the first heading.
  heading     String
  text        String
  model       String
  /// Of all the article's chunks (the same on each), to tell when they need embedding again.
  contentHash String
  embedding   Unsupported("vector(1536)")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([articleId, position])
  @@index([projectId])
  @@map("article_chunk")
}

enum CodeChangeState {
  /// Waiting for its analysis, or in it.
  ANALYSING
  /// Its proposed actions are ready for the team.
  READY
  /// Nothing users see changed, so there's nothing to propose (`reason` says why).
  NOTHING_TO_DO
  /// The analysis failed (`reason` says where); it's retried, and the team can analyse it again.
  FAILED
  /// Not analysed: the project was out of AI credits. Nothing resumes it by itself; the team does (codeChanges.analyse).
  PAUSED
}

enum CodeChangeActionKind {
  /// Links the post to the pull request, nothing more: a post it touches without resolving.
  LINKS
  /// Links the post and completes it (its people get the shipped emails).
  RESOLVES
  /// Posts the team's comment on the post (and In progress, if it was earlier).
  MOVES_FORWARD
  /// An edit to a published article, against the revision it was written from.
  ARTICLE_EDIT
  /// A new article, as a draft.
  NEW_ARTICLE
  /// The pull request's line in the changelog's running draft.
  CHANGELOG_LINE
}

enum CodeChangeActionStatus {
  PENDING
  APPLIED
  DISMISSED
  /// Its article changed since the edit was written: write it again, or dismiss it.
  STALE
}

/// A merged pull request, analysed once into actions the team applies, edits or dismisses (docs/plan.md,
/// Code changes). Nothing customer-facing changes until someone applies an action. Belongs to its
/// project, and goes with it.
model CodeChange {
  id        String          @id @default(cuid())
  projectId String
  /// GitHub's id for the repository, and its owner/name when it merged.
  repoId    Int
  repo      String
  number    Int
  url       String
  title     String
  /// The pull request's author on GitHub (login).
  author    String
  mergedAt  DateTime
  state     CodeChangeState @default(ANALYSING)
  /// Why there's nothing to do, or where the analysis failed. Never diff text.
  reason    String          @default("")
  /// What changed for users, and why Tuti proposes its actions (both written by the model).
  summary   String          @default("")
  why       String          @default("")
  /// The writing model and the decision model that analysed it, so a new one re-analyses only on request.
  model     String?
  decider   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions CodeChangeAction[]
  links   PostLink[]

  @@unique([projectId, repoId, number])
  @@index([projectId, createdAt])
  @@map("code_change")
}

/// One thing a code change proposes. Its target is a post or an article (none for a new article until
/// its draft exists, nor for the changelog line, whose bullet in the running draft is found by the pull
/// request's URL).
model CodeChangeAction {
  id            String                 @id @default(cuid())
  codeChangeId  String
  kind          CodeChangeActionKind
  postId        String?
  articleId     String?
  /// The decision model's probability that it's right.
  probability   Float
  /// Why Tuti proposes it.
  reason        String                 @default("")
  /// What applying it writes, by kind: a comment, an article's content and the revision it's against, a line.
  payload       Json                   @default("{}")
  status        CodeChangeActionStatus @default(PENDING)
  /// Who applied or dismissed it, and when.
  decidedById   String?
  decidedAt     DateTime?
  dismissReason String                 @default("")
  createdAt     DateTime               @default(now())

  codeChange CodeChange @relation(fields: [codeChangeId], references: [id], onDelete: Cascade)
  post       Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  article    Article?   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  decidedBy  User?      @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([codeChangeId])
  @@index([postId])
  @@index([articleId])
  @@map("code_change_action")
}

/// One AI request a project caused (docs/plan.md, AI usage per project): what it was for, the model,
/// tokens in and out, and its cost in dollars (null when the provider didn't say). Only answered
/// requests; kept for billing, and deleted with the project.
model AiUsage {
  id           String   @id @default(cuid())
  projectId    String
  /// What it was for: answers, escalations, changelog, code_changes.
  feature      String
  /// chat or decision (embeddings aren't recorded).
  kind         String
  model        String
  inputTokens  Int
  outputTokens Int
  cost         Decimal? @db.Decimal(16, 10)
  /// The AI credits it was charged, at the rate of the time (null with credits off); 0 for a request with no cost.
  credits      Decimal? @db.Decimal(20, 6)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("ai_usage")
}

enum AiCreditSource {
  /// AI_CREDITS_FREE, once per project.
  FREE
  /// Bought (Stripe).
  TOPUP
  /// A plan's credits for its billing period.
  PLAN
  /// Given by the operator (scripts/credits.mjs).
  MANUAL
}

/// AI credits a project was given (docs/plan.md, AI usage per project): spent soonest-expiring first,
/// and gone once they expire. The balance is what's left of unexpired grants, less the project's debt.
model AiCreditGrant {
  id        String         @id @default(cuid())
  projectId String
  source    AiCreditSource
  credits   Decimal        @db.Decimal(20, 6)
  remaining Decimal        @db.Decimal(20, 6)
  /// Null: for good.
  expiresAt DateTime?
  /// For the operator: why it was given (a support case, a plan's period).
  note      String         @default("")
  /// A top-up's Stripe Checkout Session: one grant per payment, however often Stripe says it's paid.
  stripeSessionId String?  @unique
  /// What a top-up paid, in US cents.
  paidCents Int?
  createdAt DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, expiresAt])
  @@map("ai_credit_grant")
}

/// Licences Tuti sells (used only where LICENSE_PRIVATE_KEY is set: tuti.so), one per installation and
/// project, each hiding "Powered by tuti" on that project's portal (see server/license-server.ts).
/// Installations renew their key with a one-time refresh token. Tokens are derived from the private
/// key, the licence and a generation, so none is stored: the current one is `generation`'s, and 0
/// means no installation has claimed it yet.
model License {
  id             String    @id @default(cuid())
  installationId String
  projectId      String
  /// False once cancelled: renewals are refused, so the installation's key lapses.
  active         Boolean   @default(true)
  generation     Int       @default(0)
  /// The request that made the current generation: a retry of it with the previous token (its answer
  /// was lost) gets the same answer again.
  requestId      String?
  /// The app version the installation last renewed from, for support.
  version        String?
  lastRefreshAt  DateTime?
  /// Requests with a spent token or a second claim, i.e. the licence in use on another installation.
  refusedCount   Int       @default(0)
  lastRefusedAt  DateTime?
  createdAt      DateTime  @default(now())

  @@unique([installationId, projectId])
  @@map("license")
}
