generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────
// Generated by Better Auth (`npx auth@1.7.7 generate`). Keep field names as-is;
// the domain back-relations on User are ours.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  memberships Member[]
  posts       Post[]
  votes       Vote[]
  comments    Comment[]
  ssoIdentity SsoIdentity?

  invitationsCreated  Invitation[] @relation("InvitationCreatedBy")
  invitationsAccepted Invitation[] @relation("InvitationAcceptedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────
// Every domain table carries workspaceId so a single deployment can host many
// workspaces (and so self-hosters with one workspace pay nothing extra).

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  /// HS256 secret the workspace's own app uses to sign SSO tokens. SSO is
  /// enabled when this is set. Stored as-is because verification needs it.
  ssoSecret String?
  /// Last post number handed out; posts are numbered #1, #2, … per workspace.
  postCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       Member[]
  boards        Board[]
  posts         Post[]
  votes         Vote[]
  comments      Comment[]
  ssoIdentities SsoIdentity[]
  ssoTokenUses  SsoTokenUse[]
  invitations   Invitation[]

  @@map("workspace")
}

/// Team members who manage a workspace. End users who vote and comment are
/// plain `User`s and don't need a membership.
model Member {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("member")
}

// ─── SSO ─────────────────────────────────────────────────────────────────────

/// A user signed in through a workspace's JWT SSO. Users are matched by the
/// workspace's own user id (`sub`), never by email, so each (workspace, sub) gets
/// its own User and one workspace can't sign in as another workspace's users.
model SsoIdentity {
  id          String   @id @default(cuid())
  workspaceId String
  /// The `sub` claim: the user's id in the workspace's app.
  externalId  String
  userId      String   @unique
  /// Email as asserted by the workspace's app (User.email is a placeholder).
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, externalId])
  @@map("sso_identity")
}

/// Token ids (`jti`) already used, so a token can't be replayed. Rows are only
/// needed until the token would have expired anyway.
model SsoTokenUse {
  workspaceId String
  jti         String
  expiresAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, jti])
  @@index([expiresAt])
  @@map("sso_token_use")
}

/// A single-use link that adds someone to a workspace with a given role.
/// Only a hash of the token is stored; the link is shown once when created.
model Invitation {
  id           String     @id @default(cuid())
  workspaceId  String
  role         MemberRole @default(MEMBER)
  tokenHash    String     @unique
  createdById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("invitation")
}

// ─── Feedback ────────────────────────────────────────────────────────────────

enum PostStatus {
  OPEN
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

model Board {
  id          String   @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     Post[]

  @@unique([workspaceId, slug])
  @@map("board")
}

model Post {
  id            String     @id @default(cuid())
  workspaceId   String
  boardId       String
  authorId      String
  /// Per-workspace number (#123), used in URLs: /p/<title>-<number>.
  number        Int
  title         String
  body          String     @default("")
  status        PostStatus @default(OPEN)
  /// Denormalised so boards can sort by votes without a COUNT per row.
  voteCount     Int        @default(0)
  commentCount  Int        @default(0)
  /// Set when this post is merged into another one; votes move to the original.
  duplicateOfId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  duplicateOf Post?     @relation("PostDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Post[]    @relation("PostDuplicates")
  votes       Vote[]
  comments    Comment[]

  @@unique([workspaceId, number])
  @@index([boardId, voteCount(sort: Desc)])
  @@index([boardId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([duplicateOfId])
  @@map("post")
}

model Vote {
  postId      String
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("vote")
}

model Comment {
  id          String   @id @default(cuid())
  workspaceId String
  postId      String
  authorId    String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comment")
}
