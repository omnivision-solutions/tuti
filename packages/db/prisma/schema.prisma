generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────
// Generated by Better Auth (`npx auth@1.7.7 generate`). Keep field names as-is;
// the domain back-relations on User are ours.

model User {
  id               String    @id
  name             String
  email            String
  emailVerified    Boolean   @default(false)
  image            String?
  /// Secret in unsubscribe links: whoever has it can stop a project's emails to this person.
  unsubscribeToken String    @unique @default(dbgenerated("gen_random_uuid()::text"))
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
  accounts         Account[]

  teamMemberships    TeamMember[]
  posts              Post[]
  votes              Vote[]
  comments           Comment[]
  changelogReactions ChangelogReaction[]
  changelogSeen      ChangelogSeen[]
  ssoIdentity        SsoIdentity?

  invitationsCreated  Invitation[]      @relation("InvitationCreatedBy")
  portalReadersAdded  PortalReader[]    @relation("PortalReaderAddedBy")
  customDomainsAdded  CustomDomain[]    @relation("CustomDomainAddedBy")
  invitationsAccepted Invitation[]      @relation("InvitationAcceptedBy")
  portalHandoffs      PortalHandoff[]
  apiKeysCreated      ApiKey[]
  webhooksCreated     Webhook[]
  media               Media[]
  emailOptOuts        EmailOptOut[]
  shippedEmails       ShippedEmail[]
  articleRevisions    ArticleRevision[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────
// Every domain table carries projectId so a single deployment can host many
// projects (and so self-hosters with one project pay nothing extra).

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model Project {
  id                    String       @id @default(cuid())
  slug                  String       @unique
  name                  String
  /// HS256 secret the project's own app uses to sign SSO tokens. SSO is
  /// enabled when this is set. Stored as-is because verification needs it.
  ssoSecret             String?
  /// Last post number handed out; posts are numbered #1, #2, … per project.
  postCount             Int          @default(0)
  /// Last changelog entry number handed out, like postCount.
  changelogCount        Int          @default(0)
  /// How the team's changelog reads, for AI drafts: tone notes, and up to 3
  /// published entries as examples (ids; deleted or unpublished ones are skipped).
  changelogTone         String       @default("")
  changelogExampleIds   String[]     @default([])
  /// AI edits to changelog entries (changelog.rewrite) in the hour that started at
  /// changelogAiHour, for the per-project hourly cap.
  changelogAiHour       DateTime     @default(now())
  changelogAiCount      Int          @default(0)
  /// The widget's launcher on customers' sites (see the widget.* operations): its
  /// label, colour (`#rrggbb`; null is the brand green, with its dark-mode shade),
  /// corner ("bottom-right" or "bottom-left"), and up to 5 quick links shown at the
  /// top of the panel (`[{ label, url }]`, https only).
  widgetLabel           String       @default("Feedback")
  widgetColor           String?
  widgetPosition        String       @default("bottom-right")
  widgetLinks           Json         @default("[]")
  /// Branding for the portal and its help center (see the branding.* operations): a logo,
  /// one for dark mode and a favicon (uploads, attached while they're used), the accent
  /// colour (`#rrggbb`; null is the brand green), up to 5 links each in the header and the
  /// footer (`[{ label, url }]`, https only), and whether the footer says "Powered by tuti".
  brandLogoId           String?
  brandLogoDarkId       String?
  brandFaviconId        String?
  brandColor            String?
  headerLinks           Json         @default("[]")
  footerLinks           Json         @default("[]")
  poweredBy             Boolean      @default(true)
  /// Who may read the portal (see the portal.* operations and server/portal-access.ts): anyone, or
  /// when private only the project's team and the people its SSO signs in.
  portalAccess          PortalAccess @default(PUBLIC)
  /// How the help center's AI answers (see the assistant.* operations): a tone, the answer
  /// length, standing instructions, and off-limits topics (short phrases; a question that
  /// contains one gets a fixed reply without asking the model).
  assistantTone         String       @default("")
  assistantLength       AnswerLength @default(MEDIUM)
  assistantInstructions String       @default("")
  assistantOffLimits    String[]     @default([])
  /// Where "Ask a person" sends questions the AI couldn't help with (help.escalate): an
  /// address that confirmed a link we emailed it; null is off. A new address waits in
  /// supportEmailPending (with the hash of its link's token) until it's confirmed, and the
  /// confirmed one keeps working meanwhile.
  supportEmail          String?
  supportEmailPending   String?
  supportEmailTokenHash String?      @unique
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  team                 TeamMember[]
  boards               Board[]
  posts                Post[]
  votes                Vote[]
  comments             Comment[]
  ssoIdentities        SsoIdentity[]
  ssoTokenUses         SsoTokenUse[]
  portalHandoffs       PortalHandoff[]
  signInLinks          SignInLink[]
  apiKeys              ApiKey[]
  githubInstallation   GithubInstallation?
  postLinks            PostLink[]
  webhooks             Webhook[]
  media                Media[]               @relation("projectMedia")
  brandLogo            Media?                @relation("brandLogo", fields: [brandLogoId], references: [id], onDelete: SetNull)
  brandLogoDark        Media?                @relation("brandLogoDark", fields: [brandLogoDarkId], references: [id], onDelete: SetNull)
  brandFavicon         Media?                @relation("brandFavicon", fields: [brandFaviconId], references: [id], onDelete: SetNull)
  invitations          Invitation[]
  boardRedirects       BoardRedirect[]
  postEmbeddings       PostEmbedding[]
  duplicateSuggestions DuplicateSuggestion[]
  emailOptOuts         EmailOptOut[]
  githubPrComments     GithubPrComment[]
  linkSuggestions      LinkSuggestion[]
  changelogEntries     ChangelogEntry[]
  articles             Article[]
  articleChunks        ArticleChunk[]
  collections          Collection[]
  helpSections         HelpSection[]
  portalReaders        PortalReader[]
  portalReaderEmails   PortalReaderEmail[]
  customDomain         CustomDomain?
  helpSearches         HelpSearch[]
  helpQuestions        HelpQuestion[]
  helpGapDismissals    HelpGapDismissal[]
  changelogSeen        ChangelogSeen[]

  @@map("project")
}

/// The team that manages a project. Users who vote and comment on its portal
/// are plain `User`s and aren't on the team.
model TeamMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("team_member")
}

// ─── SSO ─────────────────────────────────────────────────────────────────────

/// A user signed in through a project's JWT SSO. Users are matched by the
/// project's own user id (`sub`), never by email, so each (project, sub) gets
/// its own User and one project can't sign in as another project's users.
model SsoIdentity {
  id         String   @id @default(cuid())
  projectId  String
  /// The `sub` claim: the user's id in the project's app.
  externalId String
  userId     String   @unique
  /// Email as asserted by the project's app (User.email is a placeholder).
  email      String?
  /// The `groups` claim of their latest sign-in (lowercase), e.g. ["enterprise"]: which restricted
  /// help center collections they may read (Collection.groups).
  groups     String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalId])
  @@map("sso_identity")
}

/// Token ids (`jti`) already used, so a token can't be replayed. Rows are only
/// needed until the token would have expired anyway.
model SsoTokenUse {
  projectId String
  jti       String
  expiresAt DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, jti])
  @@index([expiresAt])
  @@map("sso_token_use")
}

enum MediaStatus {
  /// Waiting for the browser to upload the file.
  UPLOADING
  /// Uploaded; the image job is checking and re-encoding it.
  PROCESSING
  READY
  /// Not an image we accept, or processing failed. The file is gone.
  FAILED
}

/// An uploaded image (see @tuti/content media.ts for where its files live).
model Media {
  id         String      @id @default(cuid())
  projectId  String
  uploaderId String
  status     MediaStatus @default(UPLOADING)
  /// Bytes counted against the project's quota: the declared upload size until
  /// processed, then the size of the files kept.
  size       Int
  /// After processing (longest side at most 2400px).
  width      Int?
  height     Int?
  /// Set (again) whenever content using it is saved; cleared by the release-media job once
  /// no content uses it. Uploads without it are deleted a day after they were uploaded.
  attachedAt DateTime?
  createdAt  DateTime    @default(now())

  project    Project   @relation("projectMedia", fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  /// Projects whose branding uses it (see Project.brandLogoId).
  logoOf     Project[] @relation("brandLogo")
  logoDarkOf Project[] @relation("brandLogoDark")
  faviconOf  Project[] @relation("brandFavicon")

  @@index([projectId])
  @@index([uploaderId, createdAt])
  @@index([attachedAt, createdAt])
  @@map("media")
}

enum ApiKeyScope {
  READ
  /// Read and write.
  WRITE
}

/// A project's key for the REST API and MCP. The key is shown once; only its hash is stored.
model ApiKey {
  id              String      @id @default(cuid())
  projectId       String
  name            String
  scope           ApiKeyScope
  keyHash         String      @unique
  /// The key's first characters, so people can tell keys apart (tuti_ab12…).
  prefix          String
  createdById     String
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  /// Requests in the current minute, for the per-key rate limit.
  rateWindowStart DateTime?
  rateCount       Int         @default(0)
  createdAt       DateTime    @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("api_key")
}

enum PostLinkKind {
  PULL_REQUEST
  ISSUE
  RELEASE
}

enum PostLinkSource {
  /// Added by the team on the post.
  MANUAL
  /// Mentioned in a pull request (tuti#123 or the post's URL).
  REFERENCE
  /// Suggested by text similarity and confirmed by the team.
  SUGGESTED
}

/// A post's link to GitHub: the pull request, issue or release that works on or ships it.
model PostLink {
  id          String         @id @default(cuid())
  projectId   String
  postId      String
  kind        PostLinkKind
  /// owner/name
  repo        String
  /// PR or issue number; null for releases.
  number      Int?
  /// Release tag; null otherwise.
  tag         String?
  url         String
  /// From GitHub once the app is connected (null when added by hand).
  title       String?
  source      PostLinkSource
  createdById String?
  createdAt   DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, url])
  @@index([projectId, repo, number])
  @@map("post_link")
}

/// An endpoint that gets a project's events (signed, retried; see packages/jobs/src/webhooks.ts).
model Webhook {
  id          String   @id @default(cuid())
  projectId   String
  url         String
  /// Signs every delivery (HMAC-SHA256). Shown once when the webhook is created.
  secret      String
  /// Event types it gets, e.g. "post.created".
  events      String[]
  createdById String
  createdAt   DateTime @default(now())

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId])
  @@map("webhook")
}

/// One event for one webhook. `eventId` is the same on every retry, so receivers can skip repeats.
model WebhookDelivery {
  id          String    @id @default(cuid())
  webhookId   String
  eventId     String
  event       String
  payload     Json
  attempts    Int       @default(0)
  /// HTTP status of the last attempt (null when it didn't get a response).
  lastStatus  Int?
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_delivery")
}

enum GithubCloseOn {
  RELEASE
  MERGE
}

/// A project's GitHub App installation: its pull requests and releases link to and
/// close the project's posts. One installation (GitHub account) per project.
/// ponytail: per-repo mapping if one GitHub account needs several projects.
model GithubInstallation {
  id                    String        @id @default(cuid())
  projectId             String        @unique
  installationId        Int           @unique
  /// The GitHub user or organisation it's installed on.
  accountLogin          String
  /// When linked posts become Completed: when a release ships their pull request
  /// (default: merged isn't shipped), or when it's merged (repos without releases).
  closeOn               GithubCloseOn @default(RELEASE)
  /// Comment on pull requests that link posts, listing them with their votes (needs the App's
  /// Pull requests permission set to write).
  commentOnPullRequests Boolean       @default(false)
  createdById           String
  createdAt             DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("github_installation")
}

/// "Continue as <name>": a one-time code from the app host that signs a Tuti
/// account into one portal. Bound to the portal and to the state cookie of the
/// browser that asked for it; deleted when used. Only hashes are stored.
/// Someone the team lets read its private portal without being on the team or signed in by its
/// SSO: any account with this email, once the email is verified (an emailed sign-in link verifies it).
model PortalReader {
  id        String   @id @default(cuid())
  projectId String
  /// Lowercase.
  email     String
  addedById String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("PortalReaderAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([projectId, email])
  @@map("portal_reader")
}

enum CertificateStatus {
  PENDING
  ACTIVE
  FAILED
}

/// A portal's own domain (help.acme.com) in place of <project>.tuti.so, one per project. It serves
/// the portal once verified: a TXT record at _tuti.<hostname> with this project's token shows the
/// team controls the domain's DNS. The hostname is unique only among verified ones, so adding
/// someone else's domain first can't keep them from using it.
model CustomDomain {
  id                String             @id @default(cuid())
  projectId         String             @unique
  /// Lowercase ASCII (international names as punycode), no port.
  hostname          String
  /// Goes in the TXT record, so not a secret: it ties the record to this project.
  verificationToken String
  verifiedAt        DateTime?
  /// Its custom hostname at Cloudflare for SaaS (made once it's verified, when the server uses
  /// Cloudflare for customers' certificates), and that certificate's status: PENDING until
  /// Cloudflare has it (the CNAME must point at CUSTOM_DOMAIN_TARGET), then ACTIVE, or FAILED.
  cloudflareId      String?            @unique
  certificate       CertificateStatus?
  addedById         String?
  createdAt         DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("CustomDomainAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([hostname], where: raw("\"verifiedAt\" IS NOT NULL"))
  @@map("custom_domain")
}

/// An email to a new reader of a private portal, kept a day for the send limits (per project, and
/// per address across projects), so removing and adding someone again can't send more.
model PortalReaderEmail {
  id        String   @id @default(cuid())
  /// Null once the project is deleted: the row still counts for the address.
  projectId String?
  /// SHA-256 of the lowercase address (hashSecret, as sign_in_link), not the address.
  emailHash String
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([emailHash, createdAt])
  /// For deleting the expired ones.
  @@index([createdAt])
  @@map("portal_reader_email")
}

model PortalHandoff {
  codeHash  String   @id
  projectId String
  userId    String
  stateHash String
  expiresAt DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("portal_handoff")
}

/// A sign-in link a portal emailed (magic link) or a password reset link the app
/// or a portal emailed (the token itself is Better Auth's verification row).
/// projectId is the portal it was asked on, null for the app host. Kept for an
/// hour: for the hourly limits per address, per visitor and per site (both kinds
/// count together), and to check a link is only used on the host that sent it.
/// Only hashes are stored (tokenHash is set once the link is made;
/// clientHash is an HMAC of the visitor's IP address, keyed with the auth secret,
/// and null without TRUSTED_IP_HEADER).
model SignInLink {
  id         String   @id @default(cuid())
  projectId  String?
  emailHash  String
  clientHash String?
  tokenHash  String?  @unique
  createdAt  DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([emailHash, createdAt])
  @@index([clientHash, createdAt])
  @@index([projectId, createdAt])
  @@map("sign_in_link")
}

/// A single-use link that adds someone to a project with a given role.
/// Only a hash of the token is stored; the link is shown once when created.
model Invitation {
  id           String    @id @default(cuid())
  projectId    String
  /// Who it's for (lowercase): only an account with this email can accept. Null for older link-only invites.
  email        String?
  role         TeamRole  @default(MEMBER)
  tokenHash    String    @unique
  createdById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, email])
  @@map("invitation")
}

// ─── Feedback ────────────────────────────────────────────────────────────────

enum PostStatus {
  OPEN
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

model Board {
  id          String   @id @default(cuid())
  projectId   String
  slug        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  posts     Post[]
  redirects BoardRedirect[]

  @@unique([projectId, slug])
  @@map("board")
}

/// A board's previous URL, so links keep working after its slug changes.
/// Freed up when a board takes the slug again.
model BoardRedirect {
  id        String   @id @default(cuid())
  projectId String
  boardId   String
  slug      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([boardId])
  @@map("board_redirect")
}

model Post {
  id                 String     @id @default(cuid())
  projectId          String
  boardId            String
  authorId           String
  /// Per-project number (#123), used in URLs: /p/<title>-<number>.
  number             Int
  title              String
  /// Plain text of the post (derived from `content`), for previews, search and embeddings.
  body               String     @default("")
  /// The post as rich content (@tuti/content "post" profile, ProseMirror JSON).
  /// Null for posts written before rich text: their `body` is the plain text.
  content            Json?
  status             PostStatus @default(OPEN)
  /// Denormalised so boards can sort by votes without a COUNT per row.
  voteCount          Int        @default(0)
  commentCount       Int        @default(0)
  /// Set when this post is merged into another one; votes move to the original.
  duplicateOfId      String?
  /// Set when the post is completed, cleared once everyone is emailed; the shipped-emails-resubmit cron re-runs late ones.
  shippedEmailsDueAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board                  Board                 @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author                 User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  duplicateOf            Post?                 @relation("PostDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates             Post[]                @relation("PostDuplicates")
  shippedEmails          ShippedEmail[]
  linkSuggestions        LinkSuggestion[]
  changelogEntries       ChangelogEntryPost[]
  votes                  Vote[]
  comments               Comment[]
  embedding              PostEmbedding?
  duplicateSuggestions   DuplicateSuggestion[] @relation("SuggestedDuplicate")
  duplicateOfSuggestions DuplicateSuggestion[] @relation("SuggestedOriginal")

  links PostLink[]

  @@unique([projectId, number])
  /// Trigram index for "similar posts" suggestions (pg_trgm).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "post_title_trgm_idx")
  @@index([boardId, voteCount(sort: Desc)])
  @@index([boardId, createdAt(sort: Desc)])
  @@index([projectId, status])
  @@index([duplicateOfId])
  @@index([shippedEmailsDueAt])
  @@map("post")
}

model Vote {
  postId    String
  userId    String
  projectId String
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("vote")
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  postId    String
  authorId  String
  /// Plain text (derived from `content`).
  body      String
  /// Rich content (@tuti/content "comment" profile); null for comments from before rich text.
  content   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comment")
}

// ─── Duplicate detection ─────────────────────────────────────────────────────

/// OpenAI text-embedding-3-small vector of a post's title + body (pgvector).
/// `contentHash` tells when the text changed and needs re-embedding.
model PostEmbedding {
  postId      String                      @id
  projectId   String
  model       String
  contentHash String
  embedding   Unsupported("vector(1536)")
  updatedAt   DateTime                    @updatedAt

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("post_embedding")
}

enum DuplicateSuggestionStatus {
  PENDING
  DISMISSED
}

/// "This post may duplicate that older one", for the team to merge or dismiss.
model DuplicateSuggestion {
  id         String                    @id @default(cuid())
  projectId  String
  /// The newer post, which would be merged…
  postId     String
  /// …into this older one.
  originalId String
  similarity Float
  status     DuplicateSuggestionStatus @default(PENDING)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post     Post    @relation("SuggestedDuplicate", fields: [postId], references: [id], onDelete: Cascade)
  original Post    @relation("SuggestedOriginal", fields: [originalId], references: [id], onDelete: Cascade)

  @@unique([postId, originalId])
  @@index([projectId, status])
  @@index([originalId])
  @@map("duplicate_suggestion")
}

/// Someone who unsubscribed from a project's emails.
model EmailOptOut {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("email_opt_out")
}

/// Emailing someone that a post shipped: claimed, then sent (once per post and person).
model ShippedEmail {
  postId    String
  userId    String
  /// When a run took this person on; an unsent claim this old is a crashed run's, and is taken over.
  claimedAt DateTime  @default(now())
  sentAt    DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("shipped_email")
}

/// Tuti's comment on a pull request (the feedback it completes), so it's edited rather than written again.
model GithubPrComment {
  /// The repository's full name (owner/name) and the pull request's number.
  repo      String
  number    Int
  projectId String
  commentId BigInt
  /// What it says now, so an unchanged list isn't written again.
  body      String
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([repo, number])
  @@index([projectId])
  @@map("github_pr_comment")
}

enum LinkSuggestionStatus {
  PENDING
  DISMISSED
}

/// "This pull request may be what that post asks for" (by text similarity), for the
/// team to link (which makes a SUGGESTED link and removes this) or dismiss.
model LinkSuggestion {
  id         String               @id @default(cuid())
  projectId  String
  postId     String
  /// owner/name
  repo       String
  number     Int
  url        String
  title      String
  similarity Float
  status     LinkSuggestionStatus @default(PENDING)
  createdAt  DateTime             @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, url])
  @@index([projectId, status])
  @@map("link_suggestion")
}

// ─── Changelog (Phase 8) ─────────────────────────────────────────────────────

enum ChangelogTag {
  NEW
  IMPROVED
  FIXED
  BREAKING
}

/// A changelog entry: a draft the team writes, then publishes on the portal's /changelog.
model ChangelogEntry {
  id          String         @id @default(cuid())
  projectId   String
  /// Per-project number, like posts.
  number      Int
  title       String
  /// Plain text of the entry (derived from `content`).
  body        String         @default("")
  /// Rich content (@tuti/content "changelog" profile).
  content     Json?
  tags        ChangelogTag[]
  /// Null while it's a draft.
  publishedAt DateTime?
  /// Published with an announcement (the widget shows it as new), or quietly.
  announced   Boolean        @default(false)
  /// The running draft: merged pull requests are added to it until a release (or
  /// publishing it) closes it. At most one per project (a partial unique index).
  collecting  Boolean        @default(false)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  posts        ChangelogEntryPost[]
  pullRequests ChangelogEntryPullRequest[]
  reactions    ChangelogReaction[]

  @@unique([projectId, number])
  @@index([projectId, publishedAt])
  @@map("changelog_entry")
}

enum ChangelogReactionKind {
  THUMBS_UP
  HEART
  TADA
}

/// A reader's reaction to a published changelog entry: one of each kind per person.
model ChangelogReaction {
  entryId   String
  userId    String
  kind      ChangelogReactionKind
  createdAt DateTime              @default(now())

  entry ChangelogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([entryId, userId, kind])
  @@index([userId])
  @@map("changelog_reaction")
}

/// How far someone has read a project's announcements (What's new in the widget, the
/// portal's /changelog): announced entries published after `seenAt` are new to them.
/// Only ever moves forward, so seeing them on one device clears them on the others.
model ChangelogSeen {
  projectId String
  userId    String
  seenAt    DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("changelog_seen")
}

/// A post a changelog entry completes ("Shipped in …").
model ChangelogEntryPost {
  entryId String
  postId  String

  entry ChangelogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  post  Post           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([entryId, postId])
  @@index([postId])
  @@map("changelog_entry_post")
}

/// A merged pull request added to a changelog entry's running draft (once each).
model ChangelogEntryPullRequest {
  entryId   String
  url       String
  /// owner/name
  repo      String
  number    Int
  title     String
  createdAt DateTime @default(now())

  entry ChangelogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, url])
  @@map("changelog_entry_pull_request")
}

/// A help center collection: a group of articles on the portal's /help.
model Collection {
  id          String   @id @default(cuid())
  projectId   String
  /// From the name, unique in the project.
  slug        String
  name        String
  description String   @default("")
  /// Among its siblings (same parent), collections are listed by this, then by name; new ones go last.
  order       Int      @default(0)
  /// The collection it's in, in the same project. At most 2 levels: a collection with a parent has
  /// no children (checked under the project's lock). Deleting the parent moves its children up a level.
  parentId    String?
  /// The section (a tab of the help center) a top-level collection is in; null inside another
  /// collection (it's in its parent's). Once a project has sections, every top-level collection is
  /// in one (kept under the project's lock); without any, all are null.
  sectionId   String?
  /// Who may read it (and the articles and collections in it) besides the team: people the project's
  /// SSO signs in with one of these groups (lowercase). Empty: everyone who may read the portal.
  groups      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Collection?       @relation("CollectionParent", fields: [parentId], references: [id], onDelete: SetNull)
  section   HelpSection?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  children  Collection[]      @relation("CollectionParent")
  articles  Article[]
  revisions ArticleRevision[]
  changes   ArticleChanges[]

  @@unique([projectId, slug])
  @@index([parentId])
  @@index([sectionId])
  @@map("collection")
}

/// A section of the help center, shown to readers as a tab ("Guides", "API"), with top-level
/// collections in it. The first one also lists the articles in no collection.
model HelpSection {
  id        String   @id @default(cuid())
  projectId String
  /// From the name, unique in the project.
  slug      String
  name      String
  /// Sections are listed by this, then by name; new ones go last.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collections Collection[]

  @@unique([projectId, slug])
  @@map("help_section")
}

/// A help center article, at /help/<slug> on the portal once it's published.
/// Where a published article is served. A draft is served nowhere, whatever it says.
enum ArticleListing {
  /// Its page, the help center's lists, search, the sitemap, llms.txt and AI answers.
  EVERYWHERE
  /// Readable by its link (page and .md) and cited by AI answers, but in no list, search, sitemap or llms.txt.
  UNLISTED
  /// Kept published but served nowhere public: no page, list, search or AI answers.
  HIDDEN
  /// Only a source for AI answers, which name it without a link: no page, list or search.
  AI_ONLY
}

model Article {
  id              String         @id @default(cuid())
  projectId       String
  /// From the title, unique in the project; follows the title while it's a draft.
  slug            String
  title           String
  /// Plain text of the article (derived from `content`).
  body            String         @default("")
  /// Rich content (@tuti/content "article" profile).
  content         Json?
  /// Null while it's a draft.
  publishedAt     DateTime?
  /// Set when it's deleted: the team can restore it (as a draft) for 30 days, then the
  /// `purge-articles` job removes it. A deleted article is never published (a check
  /// constraint), so everything that reads published articles leaves it out, and its
  /// slug is free for other articles.
  deletedAt       DateTime?
  /// Show "Updated <date>" on the portal when it was edited after it was published.
  showUpdatedDate Boolean        @default(true)
  /// Where a published article is served (see ArticleListing). Changed at once, never kept
  /// as an unpublished change: it says who may read the article, not what it says.
  listing         ArticleListing @default(EVERYWHERE)
  /// When changes to it last went live while it was published: the portal's "Updated" date.
  revisedAt       DateTime?
  /// At most one collection; deleting it leaves its articles uncollected.
  collectionId    String?
  /// Among the articles in its collection (or in none), listed by this, then by title; new ones go last.
  order           Int            @default(0)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collection Collection?       @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  chunks     ArticleChunk[]
  feedback   ArticleFeedback[]
  viewDays   ArticleViewDay[]
  revisions  ArticleRevision[]
  changes    ArticleChanges?

  @@unique([projectId, slug], where: raw("\"deletedAt\" IS NULL"))
  @@index([collectionId])
  @@index([deletedAt])
  @@map("article")
}

/// A saved version of an article: every save that changes its title, text or collection adds
/// one (the newest is the current version). Restoring an old one saves it again as a new one.
/// Only the newest ARTICLE_REVISIONS_KEPT (apps/web operations/help.ts) are kept.
model ArticleRevision {
  id           String   @id @default(cuid())
  articleId    String
  title        String
  /// Plain text (derived from `content`), what the history's diff compares.
  body         String   @default("")
  content      Json?
  collectionId String?
  /// The person who saved it (an API key's creator for API saves).
  authorId     String?
  createdAt    DateTime @default(now())

  article    Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([collectionId])
  @@index([authorId])
  @@map("article_revision")
}

/// Unpublished changes to a published article: saving a published article keeps its title,
/// text and collection here, and readers (the portal, search, AI answers, the sitemap, …) keep
/// the published version in `article` until the team publishes the changes or discards them.
/// Each save is still a revision. Only published articles have them: unpublishing or deleting
/// an article makes them its draft's text.
model ArticleChanges {
  articleId    String   @id
  title        String
  /// Plain text (derived from `content`).
  body         String   @default("")
  content      Json?
  collectionId String?
  updatedAt    DateTime @updatedAt

  article    Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@map("article_changes")
}

/// A reader's answer to "Was this helpful?" under a published article: one per reader
/// and article, the latest answer wins. No IP addresses or user agents.
model ArticleFeedback {
  articleId String
  /// The signed-in user's id (or the user an API key answered for), or an anonymous
  /// reader's first-party cookie id (a random UUID).
  readerId  String
  helpful   Boolean
  /// What was missing; only with a "No".
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, readerId])
  @@map("article_feedback")
}

/// How often an article's portal page was viewed on a day (UTC): a counter per article
/// and day, not a row per view.
model ArticleViewDay {
  articleId String
  day       DateTime @db.Date
  views     Int

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day])
  @@map("article_view_day")
}

/// A help center search: its normalized query and how many articles it found (0 is a
/// failed search). Nothing about who searched.
model HelpSearch {
  id        String   @id @default(cuid())
  projectId String
  query     String
  results   Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("help_search")
}

/// What became of a question asked of the help center's AI.
enum HelpAnswerStatus {
  /// Answered from the project's published articles, with sources.
  ANSWERED
  /// "I don't know": no section was relevant enough, or the model cited none.
  NO_ANSWER
  /// The embeddings or the model failed or took too long. Also a question's status while it's being answered.
  FAILED
}

/// Why a question got "I don't know" (NO_ANSWER), so the log's labels mean one thing.
enum HelpNoAnswerCause {
  /// No published section was close enough; the model wasn't asked.
  NO_RELEVANT_SECTION
  /// The model gave no answer, or cited none of the sections it was given.
  NO_VALID_CITATION
  /// An article it cited was unpublished or hidden while the model wrote.
  SOURCE_UNPUBLISHED
  /// The question names one of the project's off-limits topics; the model wasn't asked.
  OFF_LIMITS
  /// Asked before causes were recorded.
  UNKNOWN
}

/// Who may read a project's portal.
enum PortalAccess {
  PUBLIC
  PRIVATE
}

/// How long the help center's AI answers are (each is a sentence in the prompt and a cap on the reply).
enum AnswerLength {
  SHORT
  MEDIUM
  DETAILED
}

/// Where a question to the help center's AI was asked.
enum HelpQuestionSource {
  /// The portal's /help.
  PORTAL
  /// The widget's Help tab.
  WIDGET
  /// help.ask (REST or MCP).
  API
}

/// A question asked of the help center's AI (help.ask) and the asker's thumbs up or down:
/// what the team's Gaps list reads, and what the hourly rate limits count.
/// No IP addresses.
model HelpQuestion {
  id          String             @id @default(cuid())
  projectId   String
  /// The signed-in user's id, an anonymous reader's first-party cookie id, or the API key's id.
  askerId     String
  question    String
  source      HelpQuestionSource
  status      HelpAnswerStatus   @default(FAILED)
  /// Why it's "I don't know" (NO_ANSWER only).
  cause       HelpNoAnswerCause?
  answer      String?
  /// The articles the answer cites.
  articleIds  String[]           @default([])
  /// The asker's thumbs up (true) or down (false) on an answer.
  helpful     Boolean?
  /// When the asker passed it to the team ("Ask a person", help.escalate), and the support address it went to.
  escalatedAt DateTime?
  escalatedTo String?
  createdAt   DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, askerId, createdAt])
  @@map("help_question")
}

/// A question the team dismissed from the Gaps list: hidden as asked up to `dismissedAt`
/// (asked again later, it's back).
model HelpGapDismissal {
  projectId   String
  /// Normalized like the Gaps list groups questions: lowercase, trimmed, spaces collapsed.
  question    String
  dismissedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, question])
  @@map("help_gap_dismissal")
}

/// A section of a published article (a heading and the text up to the next one, capped
/// in length) with its embedding, for search and AI answers. Only published articles
/// have chunks; a background job replaces all of an article's when its text changes.
model ArticleChunk {
  id          String                      @id @default(cuid())
  articleId   String
  projectId   String
  /// Order in the article, from 0.
  position    Int
  /// The section's heading; "" for text before the first heading.
  heading     String
  text        String
  model       String
  /// Of all the article's chunks (the same on each), to tell when they need embedding again.
  contentHash String
  embedding   Unsupported("vector(1536)")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([articleId, position])
  @@index([projectId])
  @@map("article_chunk")
}
