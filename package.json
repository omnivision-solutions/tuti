{
  "name": "tuti",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @tuti/db db:migrate",
    "db:studio": "pnpm --filter @tuti/db db:studio",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:live": "vitest run --project live",
    "test:e2e": "turbo run build --filter=@tuti/web && playwright test",
    "env:pull": "sh scripts/env-pull.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tuti/testkit": "workspace:*",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "turbo": "^2.11.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
